<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VerseOps XrmToolBox plugin.

    Target: net48 — required by XrmToolBoxPackage 1.2025.x SDK.
    Host:   XrmToolBox loads this DLL from
            %appdata%\MscrmTools\XrmToolBox\Plugins\VerseOps\
            (release pipeline zips this in PR #5).

    Shared code lives in VerseOps.Api.Core (netstandard2.0) so this plugin
    and the WPF app render the exact same 200+ PPAC/BAP operation catalog.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VerseOps.XrmToolBox</RootNamespace>
    <AssemblyName>VerseOps.XrmToolBox</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- XrmToolBox caches plugin tile metadata (Name, BackgroundColor,
         SmallImageBase64, BigImageBase64, ...) in
         %APPDATA%\MscrmTools\XrmToolBox\Plugins\manifest.json, keyed by
         (assembly path, AssemblyVersion). If you change any ExportMetadata
         attribute (e.g. swap the tile logo) without bumping this version,
         the host serves stale cached metadata and your change won't render.
         Bump on every brand/metadata change. -->
    <Version>1.0.6.0</Version>
    <!-- XrmToolBox is the WinForms host; class library output only. -->
    <OutputType>Library</OutputType>
    <!-- NOT strong-name signed. XrmToolBox.Extensibility itself is unsigned,
         so a strong-named plugin would (a) fail to build (CS8002) without a
         suppression and (b) FileLoadException at runtime trying to resolve
         the unsigned host DLL. Matches the community convention for XTB
         plugins. If the host ever ships signed assemblies, revisit. -->
    <!-- <SignAssembly>true</SignAssembly> -->
    <!-- <AssemblyOriginatorKeyFile>..\VerseOps.snk</AssemblyOriginatorKeyFile> -->
    <!-- XrmToolBoxPackage 1.2025.10.74 ships an embedded XrmToolBox.exe that
         was built against MscrmTools.Xrm.Connection 1.2025.9.64 while the
         package's own assembly references still point at 1.2025.7.63. MSBuild
         can't reconcile the strong-name versions and floods the build with
         MSB3277 conflict reports. The plugin DLL we produce only uses public
         ConnectionDetail APIs that are stable across both versions, and the
         actual binding is satisfied at runtime by the XrmToolBox host (which
         loads its own copy). Demote the warning to a message so build output
         stays readable. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!--
    NuGet packaging for the XrmToolBox plugin store.

    The store (https://www.xrmtoolbox.com/plugins-store) scans nuget.org daily
    for packages whose Tags include "XrmToolBox" and lists them automatically.
    Tag is mandatory; everything else is metadata users see in the store UI.

    The plugin store extracts the .nupkg directly into a user's
    %APPDATA%\MscrmTools\XrmToolBox\Plugins\<PluginName>\ folder, so the
    plugin DLL AND every runtime dependency (Api.Core, MSAL, etc.) must
    ship inside the .nupkg under lib\net48\. MSAL is a PackageReference so
    NuGet resolves it client-side, but Api.Core is a ProjectReference and
    by default would be emitted as a <dependency>. The CopyProjectReferencesToPackage
    target below force-packs Api.Core's DLL into lib\net48\ alongside ours.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>VerseOps.XrmToolBox</PackageId>
    <Title>VerseOps API Explorer for Power Platform</Title>
    <Authors>VerseOps</Authors>
    <Company>SweetsNSavories</Company>
    <Copyright>(c) 2026 SweetsNSavories</Copyright>
    <Description>XrmToolBox plugin that turns the full Power Platform Admin (PPAC) + Business Application Platform (BAP) REST surface into a searchable, executable explorer. Browse 200+ documented operations (environments, environment groups, DLP policies, billing policies, governance, capacity, lifecycle, tenant settings), execute parameter-free GETs in one click, and inspect raw JSON responses — all using the XrmToolBox connection's signed-in user via silent MSAL token exchange. Same operation catalog as the standalone VerseOps WPF app.</Description>
    <PackageTags>XrmToolBox;PowerPlatform;Dataverse;Dynamics365;PPAC;BAP;REST;API;Admin;Explorer;PowerApps</PackageTags>
    <PackageProjectUrl>https://github.com/SweetsNSavories/VerseOps</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SweetsNSavories/VerseOps</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>v1.0.6 — Fix 16 PPAC catalog token mismatches: Apply to URL + Body silently no-op'd for Copy Environment, Get Environment Copy Candidates, Get/Restore Candidates, Restore Environment, Environment Group Role Assignments (3 ops), Rule Assignments by group, and all 8 Billing Policy + Billing Policy Environment ops. Root cause: shared OpParam.Token ("environmentId" / "groupId" / "policyId") didn't match those URLs' actual placeholders ("sourceEnvironmentId" / "targetEnvironmentId" / "environmentGroupId" / "billingPolicyId"). SubstituteTokens is a literal-name regex replace and preserved the {placeholder} as-is, so clicking Apply produced a URL still containing the literal token. Added Source/Target/EnvGroup/BillingPolicy Id param variants whose Token matches the URL character-for-character. UI: param-form dropdowns now go through the same FluentStyles pass as the URL/Scope/Search controls (Segoe UI 10pt, FlatStyle.System, FixedSingle borders) instead of looking 1-2pt smaller than everything else. Cached pickers (env / group / DLP / billing) surface their cache state on the Load button caption ("Load DLP (47)") and via per-row tooltip ("Cached 47 items — type to filter"), so it's obvious the data survived an op-switch and doesn't need re-loading. v1.0.5 — Host-startup + tab-close stability. Pack Microsoft.IdentityModel.Abstractions.dll alongside MSAL: MSAL 4.81 references it transitively for its telemetry surface, and without it XrmToolBox's MEF Assembly.GetTypes() scan throws ReflectionTypeLoadException during host startup, crashing Program.Main before the tile gallery renders. Make Dispose() idempotent on the plugin control: XTB can call Dispose(true) more than once on tab close, and the second call's Cancel() on the loader/executor CancellationTokenSource was throwing ObjectDisposedException and surfacing a crash dialog. v1.0.4 — Plugin-store polish: implements IGitHubPlugin (View on GitHub button on the tile), IHelpPlugin (? button → plugin README), INoConnectionRequired (no Dataverse connection prompt — the plugin uses tenant-level MSAL, not the host's IOrganizationService). Ships a dedicated plugin-focused README so the nuget.org / plugin-store landing page no longer pitches the standalone WPF app. New ISSUE_TEMPLATE + CONTRIBUTING.md in the repo. v1.0.3 — Catalog cleanup: corrected 5 BAP routes proven 404 by tenant-side verification. "Get environment" now uses /scopes/admin/ prefix (bare path 404s for tenant-admin callers). "List backups" BAP duplicate removed (PPAC equivalent works). "Get tenant settings" switched from GET to POST {} — listTenantSettings is an ARM-style list-action verb. "Update tenant settings" /scopes/admin/ prefix dropped. "Get DLP policy" documented (URL is correct, test-rig seed mismatch). v1.0.2 — Initial XrmToolBox store release. Search executes on Enter (not per-keystroke). FluentStyles theme pass. Tile branding (32x32 + 80x80 VerseOps mark).</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <!-- Force ProjectReferences (Api.Core) to be packed as files, not declared
         as NuGet dependencies. The plugin store extracts the package directly
         into the user's plugins folder; unresolved <dependency> nodes would
         leave Api.Core missing and the plugin would FileNotFoundException on
         first load. -->
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <!-- Files included in the .nupkg at the package root for NuGet UI rendering. -->
    <None Include="..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <!-- The XrmToolBox plugin store and nuget.org render PackageReadmeFile
         on the package landing page. Ship the plugin-focused README from
         this folder, NOT the root README (which pitches the WPF app and
         confuses prospective plugin users). -->
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\docs\brand\verseops-mark-256.png" Pack="true" PackagePath="\icon.png" Visible="false" />
    <!-- MSAL DLLs are explicitly packed into lib\net48\ because the XrmToolBox
         plugin store does NOT run NuGet dependency resolution on install — it
         just extracts the .nupkg straight into the user's Plugins folder. The
         <PackageReference>s below carry PrivateAssets="all", so MSAL won't
         appear as a <dependency> in the .nuspec (which would be unresolvable
         at install time anyway) and we provide the actual binaries here.
         IMPORTANT: Microsoft.IdentityModel.Abstractions is a TRANSITIVE
         dep of MSAL 4.81 (used by its telemetry callback surface). Even
         though we never call it, MSAL's metadata references it, so MEF's
         Assembly.GetTypes() scan in XrmToolBox.PluginManagerExtended.LoadParts
         throws ReflectionTypeLoadException at host startup if it's not
         dropped alongside MSAL — and that exception crashes Program.Main
         before the splash even closes. Ship it. -->
    <None Include="$(OutputPath)Microsoft.Identity.Client.dll" Pack="true" PackagePath="lib\net48\" Visible="false" />
    <None Include="$(OutputPath)Microsoft.Identity.Client.Extensions.Msal.dll" Pack="true" PackagePath="lib\net48\" Visible="false" />
    <None Include="$(OutputPath)Microsoft.IdentityModel.Abstractions.dll" Pack="true" PackagePath="lib\net48\" Visible="false" />
  </ItemGroup>

  <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget','ProjectReference'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Brings in XrmToolBox.Extensibility (PluginBase, IXrmToolBoxPlugin)
         + MscrmTools.Xrm.Connection (ConnectionDetail).
         PrivateAssets="all" — the XrmToolBox host provides these at runtime;
         we use them only at compile time, so no .nupkg dependency entry. -->
    <PackageReference Include="XrmToolBoxPackage" Version="1.2025.10.74" PrivateAssets="all" />
    <!-- XrmToolBoxPackage's embedded XrmToolBox.exe/ToolLibrary.dll were
         compiled against MscrmTools.Xrm.Connection 1.2025.7.63 while the
         package itself pulls 1.2025.9.64. Pin to the older version to
         silence MSB3277 binding conflicts. The plugin only uses public
         ConnectionDetail API that's stable across both. Host-provided at
         runtime, so PrivateAssets="all". -->
    <PackageReference Include="MscrmTools.Xrm.Connection" Version="1.2025.7.63" PrivateAssets="all" />

    <!-- MSAL stack. Versions MUST match VerseOps.App.csproj exactly so the
         DPAPI-encrypted msal_cache.bin written by the WPF app under
         %LOCALAPPDATA%\VerseOps stays binary-compatible with the plugin —
         that's how signing into the WPF app once silently logs the plugin
         in too. NO Microsoft.Identity.Client.Broker here: WAM requires a
         reliable parent-window handle, and XrmToolBox's plugin host doesn't
         give us one across all states (docked, undocked, MDI child). The
         plugin uses system-browser interactive + device-code fallback.
         PrivateAssets="all" — we explicitly pack the DLLs above into the
         .nupkg's lib\net48\ folder; the plugin store cannot fetch them
         from a <dependency> entry at install time. -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.81.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.81.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="all" — Api.Core is a sibling project we want PACKED
         (as a file, via the CopyProjectReferencesToPackage target above),
         NOT emitted as a <dependency id="VerseOps.Api.Core"> entry that
         would point at a non-existent nuget.org package and break install. -->
    <ProjectReference Include="..\VerseOps.Api.Core\VerseOps.Api.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>

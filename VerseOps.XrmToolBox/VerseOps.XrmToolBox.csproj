<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VerseOps XrmToolBox plugin.

    Target: net48 — required by XrmToolBoxPackage 1.2025.x SDK.
    Host:   XrmToolBox loads this DLL from
            %appdata%\MscrmTools\XrmToolBox\Plugins\VerseOps\
            (release pipeline zips this in PR #5).

    Shared code lives in VerseOps.Api.Core (netstandard2.0) so this plugin
    and the WPF app render the exact same 200+ PPAC/BAP operation catalog.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VerseOps.XrmToolBox</RootNamespace>
    <AssemblyName>VerseOps.XrmToolBox</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- XrmToolBox caches plugin tile metadata (Name, BackgroundColor,
         SmallImageBase64, BigImageBase64, ...) in
         %APPDATA%\MscrmTools\XrmToolBox\Plugins\manifest.json, keyed by
         (assembly path, AssemblyVersion). If you change any ExportMetadata
         attribute (e.g. swap the tile logo) without bumping this version,
         the host serves stale cached metadata and your change won't render.
         Bump on every brand/metadata change.

         IMPORTANT: PluginVersion is also embedded into PackageIconUrl below
         (xrmtoolbox-v$(PluginVersion)). The release tag MUST match this
         literal so the URL resolves once GitHub Actions tags the commit
         and the XTB store validator runs.

         IMPORTANT 2: <Version> must equal PluginVersion exactly (no
         trailing .0). The XrmToolBox plugin-store validator enforces
         "My tool library version is the same that my Nuget package version"
         per https://www.xrmtoolbox.com/documentation/for-developers/deploy-your-plugin-in-plugins-store/plugin-validation-check-list/
         by string-comparing the assembly version embedded in the plugin
         DLL against the nuspec <version>.

         CRITICAL: NuGet strips trailing .0 from a 4-part package version
         (so <Version>1.0.14.0</Version> ships as nupkg "1.0.14") BUT the
         CIL spec requires 4 ushort fields for AssemblyDef version, so the
         baked AssemblyVersion always reads back as 4-part. Net effect:
         a 3-part PluginVersion is impossible to keep in sync (nuspec stays
         3-part, asm becomes "1.0.14.0" - mismatch). Workaround: ALWAYS use
         a 4-part PluginVersion with a NON-ZERO 4th component (e.g. .1).
         NuGet then preserves all 4 parts in the nupkg version and the asm
         version reads identical. Iconator achieves the same with date
         stamping (2.YearStamp.MonthStamp.DayStamp) which is never zero on
         the day. Don't override <Version> independently of PluginVersion. -->
    <PluginVersion>1.0.15.2</PluginVersion>
    <Version>$(PluginVersion)</Version>
    <!-- XrmToolBox is the WinForms host; class library output only. -->
    <OutputType>Library</OutputType>
    <!-- NOT strong-name signed. XrmToolBox.Extensibility itself is unsigned,
         so a strong-named plugin would (a) fail to build (CS8002) without a
         suppression and (b) FileLoadException at runtime trying to resolve
         the unsigned host DLL. Matches the community convention for XTB
         plugins. If the host ever ships signed assemblies, revisit. -->
    <!-- <SignAssembly>true</SignAssembly> -->
    <!-- <AssemblyOriginatorKeyFile>..\VerseOps.snk</AssemblyOriginatorKeyFile> -->
    <!-- XrmToolBoxPackage 1.2025.10.74 ships an embedded XrmToolBox.exe that
         was built against MscrmTools.Xrm.Connection 1.2025.9.64 while the
         package's own assembly references still point at 1.2025.7.63. MSBuild
         can't reconcile the strong-name versions and floods the build with
         MSB3277 conflict reports. The plugin DLL we produce only uses public
         ConnectionDetail APIs that are stable across both versions, and the
         actual binding is satisfied at runtime by the XrmToolBox host (which
         loads its own copy). Demote the warning to a message so build output
         stays readable. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!--
    NuGet packaging for the XrmToolBox plugin store.

    The store (https://www.xrmtoolbox.com/plugins-store) scans nuget.org daily
    for packages whose Tags include "XrmToolBox" and lists them automatically.
    Tag is mandatory; everything else is metadata users see in the store UI.

    The plugin store extracts the .nupkg directly into a user's
    %APPDATA%\MscrmTools\XrmToolBox\Plugins\<PluginName>\ folder, so the
    plugin DLL AND every runtime dependency (Api.Core, MSAL, etc.) must
    ship inside the .nupkg under lib\net48\. MSAL is a PackageReference so
    NuGet resolves it client-side, but Api.Core is a ProjectReference and
    by default would be emitted as a <dependency>. The CopyProjectReferencesToPackage
    target below force-packs Api.Core's DLL into lib\net48\ alongside ours.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>VerseOps.XrmToolBox</PackageId>
    <Title>VerseOps API Explorer for Power Platform</Title>
    <Authors>VerseOps</Authors>
    <Company>SweetsNSavories</Company>
    <Copyright>(c) 2026 SweetsNSavories</Copyright>
    <Description>XrmToolBox plugin that turns the full Power Platform Admin (PPAC) + Business Application Platform (BAP) REST surface into a searchable, executable explorer. Browse 200+ documented operations (environments, environment groups, DLP policies, billing policies, governance, capacity, lifecycle, tenant settings), execute parameter-free GETs in one click, and inspect raw JSON responses — all using the XrmToolBox connection's signed-in user via silent MSAL token exchange. Same operation catalog as the standalone VerseOps WPF app.</Description>
    <PackageTags>XrmToolBox;PowerPlatform;Dataverse;Dynamics365;PPAC;BAP;REST;API;Admin;Explorer;PowerApps</PackageTags>
    <PackageProjectUrl>https://github.com/SweetsNSavories/VerseOps</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SweetsNSavories/VerseOps</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- PackageIconUrl is DEPRECATED by nuget.org in favour of PackageIcon
         (which embeds the PNG inside the .nupkg — we already do that above),
         but the XrmToolBox plugin-store registration page
         (https://www.xrmtoolbox.com/plugins/new/) STILL requires a
         URL-resolvable logo and rejects submissions with "Logo Url is not
         valid" when only the embedded form is present. Point at the
         release tag (immutable ref) so the URL can never break, even if
         the source branch is later renamed/merged/deleted. Tag is pushed
         in the same workflow run that pushes the package, so the URL
         resolves by the time NuGet indexes the nupkg. -->
    <PackageIconUrl>https://raw.githubusercontent.com/SweetsNSavories/VerseOps/xrmtoolbox-v$(PluginVersion)/docs/brand/verseops-mark-256.png</PackageIconUrl>
    <PackageReleaseNotes>v1.0.15.2 — Reissue v1.0.15.1 after fixing the GitHub Actions pre-push sanity check to allow the intended nested support-DLL layout. No package payload change beyond version metadata. v1.0.15.1 — Fix the v1.0.14.1 rejection (same misleading "XrmToolBox version dependency is missing" catchall). Root cause: known-good multi-DLL XrmToolBox packages put exactly one DLL directly in lib\&lt;tfm&gt;\Plugins\ (the actual tool assembly), and place support DLLs under lib\&lt;tfm&gt;\Plugins\&lt;ToolAssemblyName&gt;\. VerseOps v1.0.14.1 put MSAL + Api.Core DLLs beside VerseOps.XrmToolBox.dll in Plugins\, so the validator could scan a support DLL first and conclude the XrmToolBox dependency/tool metadata was missing. Fixed by keeping only VerseOps.XrmToolBox.dll at lib\net48\Plugins\ and moving VerseOps.Api.Core.dll plus MSAL dependencies to lib\net48\Plugins\VerseOps.XrmToolBox\. Also keeps the 4-part non-zero package/assembly version pattern so checklist rule #4 remains satisfied. No code changes. v1.0.14.1 — Fix the v1.0.13 rejection ("XrmToolBox version dependency is missing" — same misleading catchall error v1.0.10/11 got for a different rule). Root cause: official XTB validation checklist (https://www.xrmtoolbox.com/documentation/for-developers/deploy-your-plugin-in-plugins-store/plugin-validation-check-list/) item 4 requires "My tool library version is the same that my Nuget package version". Our v1.0.13 nuspec declared package version "1.0.13" (NuGet pack strips trailing .0 from 4-part) but the baked AssemblyVersion in VerseOps.XrmToolBox.dll was "1.0.13.0" because the CIL spec requires 4 ushort fields for AssemblyDef.Version. Fixed by using a 4-part version with a NON-ZERO 4th component (1.0.14.1) so NuGet preserves all 4 parts in the nupkg version, matching the assembly version exactly. Confirmed against canonical sample MsCrmTools.Iconator (2.YearStamp.MonthStamp.DayStamp date-stamped). No code changes. v1.0.13 — Fix the v1.0.12 "Logo Url is not valid" rejection. nuget.org’s flatcontainer icon proxy (https://api.nuget.org/v3-flatcontainer/&lt;id&gt;/&lt;ver&gt;/icon) serves the embedded PNG with whatever Content-Type the .nupkg’s [Content_Types].xml declares for the .png extension. The XrmToolBox search index records this proxy URL as the package’s iconUrl when an &lt;icon&gt; is embedded, and the plugin-store validator rejects with "Logo Url is not valid" when the response Content-Type isn’t image/*. NuGet’s pack defaults the png ContentType to "application/octet", so the proxy was returning application/octet-stream. Fixed by extending the post-pack rewrite script to also rewrite [Content_Types].xml’s &lt;Default Extension="png" /&gt; entry to ContentType="image/png". No code changes. v1.0.12 — Move every shipped DLL under lib\net48\Plugins\ inside the .nupkg. The XrmToolBox plugin-store validator requires the plugin assembly to live in a "Plugins" subfolder of lib\&lt;tfm&gt;\ (per the canonical sample at xrmtoolbox.com — confirmed by inspecting MsCrmTools.Iconator 2.2025.3.15.nupkg, which packs MsCrmTools.Iconator.dll at lib\net48\Plugins\). When the validator can't find an assembly there it returns the misleading "XrmToolBox version dependency is missing in Nuget package" rejection — the same error v1.0.10 and v1.0.11 got even with a correctly-formed marker dep. Fixed by setting &lt;IncludeBuildOutput&gt;false&lt;/IncludeBuildOutput&gt; (so the SDK Pack default no longer drops VerseOps.XrmToolBox.dll into bare lib\net48\) and explicitly &lt;None Include&gt;-packing VerseOps.XrmToolBox.dll + VerseOps.Api.Core.dll + the three MSAL DLLs into lib\net48\Plugins\. The CopyProjectReferencesToPackage MSBuild target is removed (replaced by the explicit Api.Core &lt;None&gt; entry). The marker dependency, iconUrl, embedded icon, and all v1.0.11 metadata are preserved. No code changes. v1.0.11 — Fix the v1.0.10 marker-dependency injection: NuGet's nuspec dependency model is "either grouped or flat, not both" — when any &lt;group&gt; child exists inside &lt;dependencies&gt;, loose top-level &lt;dependency&gt; siblings are silently ignored by readers (including the XrmToolBox plugin-store validator). The SDK was emitting an empty &lt;group targetFramework=".NETFramework4.8" /&gt; (because PrivateAssets="all" strips every real dep), and the inject script was appending the marker as a sibling — so the validator still reported "XrmToolBox version dependency is missing in Nuget package" against v1.0.10 even though the marker was textually present. v1.0.11 strips empty &lt;group&gt; elements before injecting, and if non-empty groups remain it places the marker inside each group instead of as a loose sibling. The resulting nuspec now matches the canonical pattern used by MsCrmTools.Iconator. No code changes. v1.0.10 — Inject &lt;dependency id="XrmToolBox" version="1.2017.10.19" /&gt; into the .nuspec via post-pack rewrite. The XrmToolBox plugin-store registration page rejects submissions whose nupkg lacks this exact dependency marker ("XrmToolBox version dependency is missing in Nuget package"), even though the package itself doesn't exist on nuget.org — the validator only reads it as a metadata signal. Our SDK-style csproj puts PrivateAssets="all" on every PackageReference so the dependencies group ships empty by default; this target writes the marker straight into the .nuspec inside the produced .nupkg, before the OIDC push step. No code changes; pure packaging metadata. v1.0.9 — Add &lt;iconUrl&gt; (deprecated by nuget.org but required by the XrmToolBox plugin-store registration page; submissions without it fail "Logo Url is not valid"). URL points at the immutable release tag so it can never 404 after a branch rename/merge. No code changes; reissue of v1.0.8. v1.0.8 — UI polish. Generic "Poll op" button is now always visible in the Response toolbar (next to Find next / Clear): if the last response carried an Operation-Location header it re-polls that URI, otherwise it GETs whatever is in the URL box, so you can paste any long-running operation URL and re-poll it without first selecting the matching catalog entry. Request and Response panels both painted SystemColors.Window (white) with a 2-px SystemColors.ControlDark splitter between them — no more "two grey strips with a wide grey gutter" look; the splitter is now the only visible boundary. Response-side search row rebuilt as a single-row TableLayoutPanel (columns: AutoSize label / Percent100 textbox / AutoSize info / 3×AutoSize buttons) instead of the prior Panel+Dock+FlowLayoutPanel, so Find next / Clear / Poll op share the textbox baseline at every DPI scale — matches the request strip's Send/Cancel/Decode-bearer alignment pattern. v1.0.7 — Description tab is now a styled rich-text view instead of a plaintext dump. The HTTP method is rendered as a color-coded pill (GET green / POST blue / PUT orange / PATCH purple / DELETE red), the URL in monospace, scope in gray, then the catalog prose. For PPAC ops whose catalog description embeds "  |  Docs: &lt;learn url&gt;", the Microsoft Learn URL is auto-detected as a hyperlink (RichTextBox.DetectUrls) and clicking it opens the docs in the user's default browser (System.Diagnostics.Process.Start) — no WebView2 runtime, no NuGet add, no HTTP fetch, no native DLL. v1.0.6 — Fix 16 PPAC catalog token mismatches: Apply to URL + Body silently no-op'd for Copy Environment, Get Environment Copy Candidates, Get/Restore Candidates, Restore Environment, Environment Group Role Assignments (3 ops), Rule Assignments by group, and all 8 Billing Policy + Billing Policy Environment ops. Root cause: shared OpParam.Token ("environmentId" / "groupId" / "policyId") didn't match those URLs' actual placeholders ("sourceEnvironmentId" / "targetEnvironmentId" / "environmentGroupId" / "billingPolicyId"). SubstituteTokens is a literal-name regex replace and preserved the {placeholder} as-is, so clicking Apply produced a URL still containing the literal token. Added Source/Target/EnvGroup/BillingPolicy Id param variants whose Token matches the URL character-for-character. UI: param-form dropdowns now go through the same FluentStyles pass as the URL/Scope/Search controls (Segoe UI 10pt, FlatStyle.System, FixedSingle borders) instead of looking 1-2pt smaller than everything else. Cached pickers (env / group / DLP / billing) surface their cache state on the Load button caption ("Load DLP (47)") and via per-row tooltip ("Cached 47 items — type to filter"), so it's obvious the data survived an op-switch and doesn't need re-loading. v1.0.5 — Host-startup + tab-close stability. Pack Microsoft.IdentityModel.Abstractions.dll alongside MSAL: MSAL 4.81 references it transitively for its telemetry surface, and without it XrmToolBox's MEF Assembly.GetTypes() scan throws ReflectionTypeLoadException during host startup, crashing Program.Main before the tile gallery renders. Make Dispose() idempotent on the plugin control: XTB can call Dispose(true) more than once on tab close, and the second call's Cancel() on the loader/executor CancellationTokenSource was throwing ObjectDisposedException and surfacing a crash dialog. v1.0.4 — Plugin-store polish: implements IGitHubPlugin (View on GitHub button on the tile), IHelpPlugin (? button → plugin README), INoConnectionRequired (no Dataverse connection prompt — the plugin uses tenant-level MSAL, not the host's IOrganizationService). Ships a dedicated plugin-focused README so the nuget.org / plugin-store landing page no longer pitches the standalone WPF app. New ISSUE_TEMPLATE + CONTRIBUTING.md in the repo. v1.0.3 — Catalog cleanup: corrected 5 BAP routes proven 404 by tenant-side verification. "Get environment" now uses /scopes/admin/ prefix (bare path 404s for tenant-admin callers). "List backups" BAP duplicate removed (PPAC equivalent works). "Get tenant settings" switched from GET to POST {} — listTenantSettings is an ARM-style list-action verb. "Update tenant settings" /scopes/admin/ prefix dropped. "Get DLP policy" documented (URL is correct, test-rig seed mismatch). v1.0.2 — Initial XrmToolBox store release. Search executes on Enter (not per-keystroke). FluentStyles theme pass. Tile branding (32x32 + 80x80 VerseOps mark).</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <!-- Suppress the SDK Pack default that drops the primary build output
         (VerseOps.XrmToolBox.dll) into lib\$(TargetFramework)\. The
         XrmToolBox plugin-store validator REQUIRES the plugin assembly to
         live under lib\$(TargetFramework)\Plugins\ (and reports the
         misleading error "XrmToolBox version dependency is missing in
         Nuget package" when it can't find an assembly there). We re-pack
         the primary DLL + Api.Core + MSAL via explicit <None Include>
         items below, all targeted at lib\net48\Plugins\. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <!-- Files included in the .nupkg at the package root for NuGet UI rendering. -->
    <None Include="..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <!-- The XrmToolBox plugin store and nuget.org render PackageReadmeFile
         on the package landing page. Ship the plugin-focused README from
         this folder, NOT the root README (which pitches the WPF app and
         confuses prospective plugin users). -->
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\docs\brand\verseops-mark-256.png" Pack="true" PackagePath="\icon.png" Visible="false" />
    <!-- Primary plugin assembly is explicitly packed under
       lib\net48\Plugins\ because:
           (a) the XrmToolBox plugin-store validator requires the plugin
               assembly under a "Plugins" subfolder of lib\<tfm>\ (per the
               canonical sample at xrmtoolbox.com — without it the validator
               returns the misleading "XrmToolBox version dependency is
               missing in Nuget package" rejection, even when the marker
               <dependency> is present in the nuspec), and
           (b) the plugin store does NOT run NuGet dependency resolution on
               install — it extracts the .nupkg straight into the user's
               %APPDATA%\MscrmTools\XrmToolBox\Plugins\<PluginName>\ folder.
               So every transitive runtime DLL must ship inside the nupkg.
       IMPORTANT: keep ONLY VerseOps.XrmToolBox.dll directly under
       Plugins\. Known-good multi-DLL tools (e.g. FetchXML Builder) put
       support DLLs under Plugins\<ToolAssemblyName>\. If support DLLs sit
       beside the tool DLL, the portal validator can scan the wrong DLL and
       emit the same "XrmToolBox version dependency is missing" catchall.
         The <PackageReference>s below carry PrivateAssets="all", so none of
         these appear as <dependency> entries in the nuspec (which would be
         unresolvable at install time anyway).
         IMPORTANT: Microsoft.IdentityModel.Abstractions is a TRANSITIVE
         dep of MSAL 4.81 (used by its telemetry callback surface). Even
         though we never call it, MSAL's metadata references it, so MEF's
         Assembly.GetTypes() scan in XrmToolBox.PluginManagerExtended.LoadParts
         throws ReflectionTypeLoadException at host startup if it's not
         dropped alongside MSAL — and that exception crashes Program.Main
         before the splash even closes. Ship it. -->
    <None Include="$(OutputPath)VerseOps.XrmToolBox.dll" Pack="true" PackagePath="lib\net48\Plugins\" Visible="false" />
    <None Include="$(OutputPath)VerseOps.Api.Core.dll" Pack="true" PackagePath="lib\net48\Plugins\VerseOps.XrmToolBox\" Visible="false" />
    <None Include="$(OutputPath)Microsoft.Identity.Client.dll" Pack="true" PackagePath="lib\net48\Plugins\VerseOps.XrmToolBox\" Visible="false" />
    <None Include="$(OutputPath)Microsoft.Identity.Client.Extensions.Msal.dll" Pack="true" PackagePath="lib\net48\Plugins\VerseOps.XrmToolBox\" Visible="false" />
    <None Include="$(OutputPath)Microsoft.IdentityModel.Abstractions.dll" Pack="true" PackagePath="lib\net48\Plugins\VerseOps.XrmToolBox\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brings in XrmToolBox.Extensibility (PluginBase, IXrmToolBoxPlugin)
         + MscrmTools.Xrm.Connection (ConnectionDetail).
         PrivateAssets="all" — the XrmToolBox host provides these at runtime;
         we use them only at compile time, so no .nupkg dependency entry. -->
    <PackageReference Include="XrmToolBoxPackage" Version="1.2025.10.74" PrivateAssets="all" />
    <!-- XrmToolBoxPackage's embedded XrmToolBox.exe/ToolLibrary.dll were
         compiled against MscrmTools.Xrm.Connection 1.2025.7.63 while the
         package itself pulls 1.2025.9.64. Pin to the older version to
         silence MSB3277 binding conflicts. The plugin only uses public
         ConnectionDetail API that's stable across both. Host-provided at
         runtime, so PrivateAssets="all". -->
    <PackageReference Include="MscrmTools.Xrm.Connection" Version="1.2025.7.63" PrivateAssets="all" />

    <!-- MSAL stack. Versions MUST match VerseOps.App.csproj exactly so the
         DPAPI-encrypted msal_cache.bin written by the WPF app under
         %LOCALAPPDATA%\VerseOps stays binary-compatible with the plugin —
         that's how signing into the WPF app once silently logs the plugin
         in too. NO Microsoft.Identity.Client.Broker here: WAM requires a
         reliable parent-window handle, and XrmToolBox's plugin host doesn't
         give us one across all states (docked, undocked, MDI child). The
         plugin uses system-browser interactive + device-code fallback.
         PrivateAssets="all" — we explicitly pack the DLLs above into the
         .nupkg's lib\net48\ folder; the plugin store cannot fetch them
         from a <dependency> entry at install time. -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.81.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.81.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="all" — Api.Core is a sibling project we want PACKED
         (as a file, via the CopyProjectReferencesToPackage target above),
         NOT emitted as a <dependency id="VerseOps.Api.Core"> entry that
         would point at a non-existent nuget.org package and break install. -->
    <ProjectReference Include="..\VerseOps.Api.Core\VerseOps.Api.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Post-pack: inject the XrmToolBox marker dependency into the produced
    .nuspec inside the .nupkg.

    Why this exists: the XrmToolBox plugin-store registration page
    (https://www.xrmtoolbox.com/plugins/new/) rejects submissions whose
    nuspec dependencies block does NOT contain
        <dependency id="XrmToolBox" version="1.2017.10.19" />
    with the error "XrmToolBox version dependency is missing in Nuget
    package". This is purely a metadata signal — the package id `XrmToolBox`
    does not actually exist on nuget.org (404 on flatcontainer), so NuGet
    never tries to resolve it at install time and the plugin store extracts
    the nupkg straight into the Plugins folder regardless.

    Our SDK-style csproj sets PrivateAssets="all" on every PackageReference
    (XrmToolBoxPackage, MscrmTools.Xrm.Connection, MSAL) so the generated
    nuspec ships with an EMPTY <dependencies/> element. To inject the
    marker without taking a real PackageReference (which would either fail
    restore or pollute the runtime asset list), we rewrite the .nuspec
    inside the produced .nupkg directly after the SDK's Pack target.

    Runs only on Windows (PowerShell + System.IO.Compression assembly). The
    publish workflow uses `windows-latest`, so this is safe on CI. Locally
    developers on Linux can still build/run; pack is the only target that
    requires the rewrite, and pack only happens via the workflow.

    The rewrite is idempotent: if the dependency is already present it's a
    no-op. Re-runs won't duplicate the entry.
  -->
  <Target Name="InjectXrmToolBoxMarkerDependency" AfterTargets="Pack" Condition="'$(IsPackable)' == 'true'">
    <PropertyGroup>
      <_XtbMarkerDepId>XrmToolBox</_XtbMarkerDepId>
      <_XtbMarkerDepVersion>1.2017.10.19</_XtbMarkerDepVersion>
    </PropertyGroup>
    <Message Importance="high" Text="InjectXrmToolBoxMarkerDependency: scanning $(PackageOutputAbsolutePath) for $(PackageId).*.nupkg" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)inject-xtb-dep.ps1&quot; -PackageOutputDir &quot;$(PackageOutputAbsolutePath)&quot; -PackageId &quot;$(PackageId)&quot; -DepId &quot;$(_XtbMarkerDepId)&quot; -DepVersion &quot;$(_XtbMarkerDepVersion)&quot;" />
  </Target>

</Project>

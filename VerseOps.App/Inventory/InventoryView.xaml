<UserControl x:Class="VerseOps.App.Inventory.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
             xmlns:local="clr-namespace:VerseOps.App.Inventory"
             mc:Ignorable="d"
             Background="{DynamicResource TokenSurfaceCanvas}"
             Foreground="{DynamicResource TokenTextPrimary}"
             FontFamily="{DynamicResource TokenFontFamilyBase}" FontSize="12"
             d:DesignHeight="700" d:DesignWidth="1400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <local:SubtractDoubleConverter x:Key="SubtractDouble"/>

        <!-- Hero KPI tile chrome (Fluent card surface) -->
        <Style x:Key="TileBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TokenSurfacePrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TokenBrandForeground}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Toolbar (top action bar) primary action -->
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource TokenBrandBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TokenTextOnAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TokenBrandBackground}"/>
            <Setter Property="Padding" Value="14,6"/>
        </Style>

        <!-- Hero KPI tile: whole card is a button so clicks open the drawer. -->
        <Style x:Key="HeroTileButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <ContentPresenter/>
                            <Border x:Name="hover" Background="{DynamicResource TokenHoverOverlay}" CornerRadius="6"
                                    Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status pill badge used in hero tiles and drawer items. -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TokenInfoBackground}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatusBadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TokenInfoForeground}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Reusable asset list-item template (single AssetRow). Used by the
             Apps / Flows / Agents sub-lists nested inside each Solution
             expander in the env row-details template. -->
        <DataTemplate x:Key="AssetListItemTemplate">
            <Border Padding="6,4" Margin="0,1">
                <StackPanel>
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{DynamicResource TokenTextPrimary}"
                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Foreground="{DynamicResource TokenTextTertiary}" FontSize="10">
                        <Run Text="{Binding TypeDisplay, Mode=OneWay}"/>
                        <Run Text=" â€¢ "/>
                        <Run Text="{Binding ModifiedUtc, StringFormat={}{0:yyyy-MM-dd}, Mode=OneWay, TargetNullValue=—}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Sub-section header used inside a Solution expander
             (APPS / FLOWS / AGENTS labels). Fluent v2 Caption Strong
             with positive letter-spacing so the all-caps reads cleanly
             at small sizes. -->
        <Style x:Key="AssetSectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource TokenBrandForeground}"/>
            <Setter Property="FontSize"    Value="{DynamicResource TokenFontSizeCaption1}"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,6"/>
            <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
        </Style>

        <!-- Solution row Expander style: card-like container that opens to
             reveal the nested apps / flows / agents lists. -->
        <Style x:Key="SolutionExpander" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="IsExpanded" Value="False"/>
        </Style>

        <!-- Compact icon-button style used for the per-row {} (inspect raw
             JSON) and â–¶ (open in maker portal) actions in every grid. -->
        <Style x:Key="RowIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TokenBrandForeground}"/>
            <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyMono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource TokenBrandBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TokenTextOnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Derivative styles that pre-bake the official Fluent System Icon for
             the two repeating row actions (open in maker portal / inspect raw
             metadata JSON). Using ContentTemplate so each button gets its own
             SymbolIcon instance — sharing one UIElement across many buttons
             would throw "Element is already the child of another element". -->
        <Style x:Key="OpenInMakerIconButton" TargetType="Button" BasedOn="{StaticResource RowIconButton}">
            <Setter Property="ToolTip" Value="Open in maker portal"/>
            <Setter Property="Content" Value=" "/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ui:SymbolIcon Symbol="Open24" FontSize="15"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InspectJsonIconButton" TargetType="Button" BasedOn="{StaticResource RowIconButton}">
            <Setter Property="ToolTip" Value="Show raw metadata JSON"/>
            <Setter Property="Content" Value=" "/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ui:SymbolIcon Symbol="Code24" FontSize="15"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Per-row "Show licenses" action: pops UserLicensesWindow with the
             chip wrap of Microsoft Graph SKU assignments enriched onto the
             UserGroupRow. Same family as the Inspector / Open-in-Maker
             icon buttons so the actions column reads consistently. -->
        <Style x:Key="ShowLicensesIconButton" TargetType="Button" BasedOn="{StaticResource RowIconButton}">
            <Setter Property="ToolTip" Value="Show assigned licenses (Microsoft Graph)"/>
            <Setter Property="Content" Value=" "/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ui:SymbolIcon Symbol="Key24" FontSize="15"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Destructive row action: revokes System Administrator from a
             Dataverse systemuser. Visibility is bound at the call-site to
             UserGroupRow.IsAdmin so it only shows for admin rows. The red
             foreground is the single signal that this is irreversible — the
             actual confirmation prompt lives in the view-model. -->
        <Style x:Key="RevokeAdminIconButton" TargetType="Button" BasedOn="{StaticResource RowIconButton}">
            <Setter Property="ToolTip" Value="Revoke System Administrator (Dataverse)"/>
            <Setter Property="Foreground" Value="{DynamicResource TokenDangerForeground}"/>
            <Setter Property="Content" Value=" "/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ui:SymbolIcon Symbol="ShieldDismiss24" FontSize="15"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Per-cell capacity TextBlock used by the Database/File/Log/FinOps
             columns. Default is the neutral primary text color; DataTriggers
             flip the foreground based on the row's *Status string ("ok",
             "warn", "over", or "" for unknown). The status comes from
             EnvironmentRow.UsageStatus(actual, limit) so the threshold logic
             stays in one place. -->
        <Style x:Key="CapacityCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="6,0"/>
            <Setter Property="FontSize"          Value="{DynamicResource TokenFontSizeBody1}"/>
            <Setter Property="FontWeight"        Value="Normal"/>
            <Setter Property="Foreground"        Value="{DynamicResource TokenTextPrimary}"/>
        </Style>

        <!-- Section header label inside a SectionExpander. Fluent v2 Body
             Strong (14 px SemiBold) so each section caption (SOLUTIONS,
             APPS, FLOWS, AGENTS, POWER PAGES, USERS & GROUPS) reads as a
             proper section title rather than fine print. -->
        <Style x:Key="SectionExpanderLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource TokenBrandForeground}"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="FontSize"    Value="{DynamicResource TokenFontSizeBody1}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionExpanderCount" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource TokenTextSecondary}"/>
            <Setter Property="FontSize"    Value="{DynamicResource TokenFontSizeCaption1}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"      Value="14,0,0,0"/>
        </Style>

        <!-- Collapsible per-section frame used inside each env row's details
             panel (Solutions/Apps/Flows/Agents/PowerPages/Users). Collapsed
             by default so the panel stays compact and the user opens only
             the sections they care about — fixes the "elongated middle
             scrollbar" problem when every section was always rendered. -->
        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="Background"      Value="{DynamicResource TokenSurfaceSecondary}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource TokenStrokeSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,4,10,10"/>
            <Setter Property="Margin"          Value="0,0,0,6"/>
            <Setter Property="IsExpanded"      Value="False"/>
        </Style>

        <!-- Maker portal Solutions glyph (stacked-documents) lifted from
             Power Apps make.powerapps.com sidebar SVG (20x20 viewbox).
             Using the real SVG path keeps the Solutions section icon
             pixel-identical to the Maker portal everywhere it appears. -->
        <Geometry x:Key="SolutionsIconGeometry">M12 2a2 2 0 0 1 2 2v8h1V4.27c.6.34 1 .99 1 1.73v6.27c.6.34 1 .99 1 1.73v1.5a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 3 15.5V9a2 2 0 0 1 1-1.73V4c0-1.1.9-2 2-2h6ZM5 7h1.88a2 2 0 0 1 1.41.59l4.12 4.12a1 1 0 0 0 .59.28V4a1 1 0 0 0-1-1H6a1 1 0 0 0-1 1v3ZM4 9v6.5c0 .83.67 1.5 1.5 1.5h9c.83 0 1.5-.67 1.5-1.5V14a1 1 0 0 0-1-1h-1.88a2 2 0 0 1-1.41-.59L7.59 8.3A1 1 0 0 0 6.88 8H5a1 1 0 0 0-1 1Z</Geometry>

        <!-- Maker portal Flows glyph (three connected nodes) lifted from
             Power Apps make.powerapps.com sidebar SVG (20x20 viewbox). -->
        <Geometry x:Key="FlowsIconGeometry">M15 5a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm-2.96 1.5a3 3 0 1 1 0 1H12c-.83 0-1.5.67-1.5 1.5v2A2.5 2.5 0 0 1 8 13.5h-.04a3 3 0 1 1 0-1H8c.83 0 1.5-.67 1.5-1.5V9A2.5 2.5 0 0 1 12 6.5h.04ZM5 11a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z</Geometry>

        <!-- Maker portal Apps glyph (rounded canvas tile + chevron arrow)
             from make.powerapps.com sidebar — filled variant. -->
        <Geometry x:Key="AppsIconGeometry">M4.5 17A1.5 1.5 0 0 1 3 15.65V4.5c0-.78.6-1.42 1.36-1.5H9c.78 0 1.42.6 1.5 1.36v.4l2.19-2.27a1.5 1.5 0 0 1 2-.14l.12.1 2.76 2.72c.55.55.6 1.42.11 2.02l-.1.11-2.31 2.2h.23c.78 0 1.42.6 1.5 1.36v4.64c0 .78-.6 1.42-1.36 1.5H4.5Zm5-6.5H4v5c0 .22.14.4.33.47l.08.02.09.01h5v-5.5Zm6 0h-5V16h5a.5.5 0 0 0 .5-.4V11a.5.5 0 0 0-.41-.5h-.09Zm-5-2.79V9.5h1.79L10.5 7.71ZM9 4.01H4.5a.5.5 0 0 0-.5.4v5.1h5.5v-5a.5.5 0 0 0-.33-.48l-.08-.02H9Z</Geometry>

        <!-- Maker portal Agents glyph (Copilot Studio agent badge with stem)
             from make.powerapps.com — composed of two distinct paths so we
             use a GeometryGroup. -->
        <GeometryGroup x:Key="AgentsIconGeometry">
            <PathGeometry Figures="M7.47087 2.82148C6.79738 2.91063 6.27761 3.43785 6.18312 4.09326L6.16089 4.09326V7.73485L3.46986 8.08757C2.72317 8.18544 2.16479 8.82177 2.16479 9.57485V14.2347H2.16675C2.20375 14.9625 2.7618 15.5636 3.49315 15.6478L6.15649 15.9546V14.9734L6.14909 14.9986L3.64947 14.6911C3.36937 14.6566 3.15894 14.4187 3.15894 14.1365C3.15894 13.8535 3.37047 13.6152 3.65145 13.5816L8.15361 13.044L9.84778 12.8214C10.5943 12.7233 11.1524 12.0871 11.1524 11.3342V11.3283C11.1411 10.6088 10.6062 10.0031 9.89099 9.90491L7.64164 9.59609C7.36294 9.55782 7.15527 9.3197 7.15527 9.03838C7.15527 8.75347 7.36815 8.51347 7.65103 8.47947L12.4487 7.90278L12.4765 7.89923L12.5706 7.88812L13.287 7.802L13.1924 7.81471L13.8316 7.73924C14.5868 7.65008 15.1557 7.00998 15.1557 6.24958V4.16098L15.1498 4.16012V3.5166C15.1498 2.60999 14.3517 1.9106 13.4529 2.02958L7.47087 2.82148Z"/>
            <PathGeometry Figures="M16.1557 4.30601V6.24958C16.1557 7.51691 15.2075 8.58374 13.9489 8.73234L12.5938 8.89233C12.3421 8.92205 12.1524 9.13542 12.1524 9.38888V11.3342C12.1524 12.589 11.2222 13.6494 9.97804 13.8129L7.59137 14.1264C7.34254 14.1591 7.15649 14.3712 7.15649 14.6222V17.0231C7.15649 17.6134 7.66355 18.0706 8.24316 18.0194L13.873 17.1887C14.6089 17.0802 15.1541 16.4487 15.1541 15.7048V12.525C15.1541 12.2798 15.3319 12.0708 15.5739 12.0315L16.8943 11.817C17.6203 11.699 18.1537 11.072 18.1537 10.3364V5.89392C18.1537 5.14866 17.6066 4.51641 16.869 4.40945L16.1557 4.30601Z"/>
        </GeometryGroup>

        <!-- Maker portal Websites glyph (browser-window outline) used for
             the Power Pages section header. -->
        <Geometry x:Key="PowerPagesIconGeometry">M3 6a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6Zm1 1v7c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V7H4Z</Geometry>
    </UserControl.Resources>

    <!-- Outer Grid hosts the dashboard content + the slide-in right drawer overlay. -->
    <Grid>
        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Branded header: logo tile + product wordmark + search + refresh.
                 Inspired by the PCF "Inventory Sentinel — ECOSYSTEM GOVERNANCE" header. -->
            <Border Grid.Row="0" CornerRadius="8" Margin="4,4,4,8" Padding="14,10"
                    Background="{DynamicResource TokenHeaderGradient}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo tile + wordmark. The brand mark is the official
                         Power Platform SVG (see ATTRIBUTIONS.md) — VerseOps is
                         not a Microsoft product, the icon attributes the
                         platform we govern. -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="44" Height="44" CornerRadius="6"
                                Background="{DynamicResource TokenHeaderLogoBackground}" Margin="0,0,12,0" Padding="6">
                            <svgc:SvgViewbox Source="/Assets/MicrosoftIcons/PowerPlatform/PowerPlatform_scalable.svg"
                                             Width="32" Height="32"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="VerseOps Inventory" Foreground="{DynamicResource TokenHeaderTextOnBrand}"
                                       FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="ECOSYSTEM GOVERNANCE" Foreground="{DynamicResource TokenHeaderSubText}"
                                       FontSize="10" FontWeight="SemiBold"
                                       Margin="0,2,0,0" Opacity="0.85"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Theme toggle + Refresh + Cancel buttons. Cancel is only enabled while a refresh is in flight. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Light/Dark theme toggle. Click handler in code-behind
                             flips ApplicationThemeManager and persists the choice.
                             MinWidth/MinHeight match the Refresh/Cancel pills so
                             the three buttons line up cleanly in the header strip. -->
                        <!-- Theme toggle hidden in the light-only build. Kept
                             in the tree (Visibility=Collapsed) so existing
                             code-behind hooks and automation IDs stay valid. -->
                        <Button x:Name="ThemeToggleButton" Style="{StaticResource ToolbarButton}"
                                AutomationProperties.AutomationId="ThemeToggleButton"
                                AutomationProperties.Name="Toggle theme"
                                Visibility="Collapsed"
                                Click="ThemeToggleButton_Click"
                                Background="{DynamicResource TokenHeaderPillInfoBg}"
                                BorderBrush="{DynamicResource TokenHeaderPillInfoBorder}"
                                Foreground="{DynamicResource TokenHeaderPillInfoFg}"
                                Padding="0" FontSize="13" FontWeight="SemiBold"
                                Width="32" Height="32"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                Margin="0,0,6,0">
                            <ui:SymbolIcon x:Name="ThemeToggleIcon" Symbol="WeatherSunny24" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}"
                                AutomationProperties.AutomationId="RefreshButton"
                                AutomationProperties.Name="Refresh"
                                Command="{Binding RefreshCommand}"
                                Background="{DynamicResource TokenHeaderPillInfoBg}"
                                BorderBrush="{DynamicResource TokenHeaderPillInfoBorder}"
                                Foreground="{DynamicResource TokenHeaderPillInfoFg}"
                                Padding="14,0" FontSize="13" FontWeight="SemiBold"
                                Height="32" VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip="Pull all environments + capacity via PPAC SDK and BAP capacity route, then replace the local catalog.">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Cancel is a sibling action to Refresh, not a destructive one
                             (it just stops an in-flight refresh; nothing is deleted), so
                             it shares the neutral pill chrome instead of using the bright
                             danger pill. The Dismiss icon already communicates intent. -->
                        <Button Style="{StaticResource ToolbarButton}"
                                AutomationProperties.AutomationId="CancelRefreshButton"
                                AutomationProperties.Name="Cancel refresh"
                                Command="{Binding CancelRefreshCommand}"
                                Background="{DynamicResource TokenHeaderPillInfoBg}"
                                BorderBrush="{DynamicResource TokenHeaderPillInfoBorder}"
                                Foreground="{DynamicResource TokenHeaderPillInfoFg}"
                                Padding="12,0" FontSize="13" FontWeight="SemiBold"
                                Height="32" VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                Margin="6,0,0,0"
                                ToolTip="Cancel the in-flight refresh. Already-loaded data stays.">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Hero KPI tiles (now clickable buttons that open the right drawer). -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource HeroTileButton}"
                        AutomationProperties.AutomationId="HeroTileEnvironments"
                        AutomationProperties.Name="Environments tile"
                        Command="{Binding OpenDrawerCommand}" CommandParameter="environments"
                        Margin="4">
                    <Border Style="{StaticResource TileBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Fluent System Icons (Globe) — matches PPAC + Maker
                                 Portal sidebar style. Single brand color so the
                                 four hero tiles read as a coherent set. -->
                            <ui:SymbolIcon Grid.Column="0" Symbol="Globe24" FontSize="32"
                                           Foreground="{DynamicResource TokenBrandForeground}"
                                           Margin="2,0,14,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ENVIRONMENTS" Style="{StaticResource TileLabel}"/>
                                <TextBlock Text="{Binding EnvironmentCount}" Style="{StaticResource TileValue}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource StatusBadge}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="SYNCED" Style="{StaticResource StatusBadgeText}"/>
                            </Border>
                        </Grid>
                    </Border>
                </Button>

                <Button Grid.Column="1" Style="{StaticResource HeroTileButton}"
                        AutomationProperties.AutomationId="HeroTileTenantDatabase"
                        AutomationProperties.Name="Tenant database tile"
                        Command="{Binding OpenDrawerCommand}" CommandParameter="storage"
                        Margin="4">
                    <Border Style="{StaticResource TileBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Database glyph for tenant Dataverse storage. -->
                            <ui:SymbolIcon Grid.Column="0" Symbol="Database24" FontSize="32"
                                           Foreground="{DynamicResource TokenBrandForeground}"
                                           Margin="2,0,14,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="TENANT DATABASE" Style="{StaticResource TileLabel}"/>
                                <TextBlock Text="{Binding DatabaseGbDisplay}" Style="{StaticResource TileValue}"
                                           ToolTip="Tenant-wide Dataverse database storage (consumed / max). Click for per-env breakdown."/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource StatusBadge}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="HEALTHY" Style="{StaticResource StatusBadgeText}"/>
                            </Border>
                        </Grid>
                    </Border>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource HeroTileButton}"
                        AutomationProperties.AutomationId="HeroTileTenantFile"
                        AutomationProperties.Name="Tenant file tile"
                        Command="{Binding OpenDrawerCommand}" CommandParameter="storage"
                        Margin="4">
                    <Border Style="{StaticResource TileBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Folder/document glyph for tenant FILE storage (separate from
                                 the database tile so the two never visually merge). -->
                            <ui:SymbolIcon Grid.Column="0" Symbol="DocumentMultiple24" FontSize="32"
                                           Foreground="{DynamicResource TokenBrandForeground}"
                                           Margin="2,0,14,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="TENANT FILE" Style="{StaticResource TileLabel}"/>
                                <TextBlock Text="{Binding FileGbDisplay}" Style="{StaticResource TileValue}"
                                           ToolTip="Tenant-wide Dataverse file storage (consumed / max). Click for per-env breakdown."/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource StatusBadge}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="HEALTHY" Style="{StaticResource StatusBadgeText}"/>
                            </Border>
                        </Grid>
                    </Border>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource HeroTileButton}"
                        AutomationProperties.AutomationId="HeroTileTotalAssets"
                        AutomationProperties.Name="Total assets tile"
                        Command="{Binding OpenDrawerCommand}" CommandParameter="assets"
                        Margin="4">
                    <Border Style="{StaticResource TileBorder}"
                            Background="{DynamicResource TokenHeroPurpleBg}"
                            BorderBrush="{DynamicResource TokenHeroPurpleBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Apps glyph — total assets is the umbrella count of
                                 every Power Apps / Flow / Agent in the tenant.
                                 Uses the live Maker portal SVG so the hero tile
                                 mirrors make.powerapps.com sidebar Apps icon. -->
                            <Viewbox Grid.Column="0" Width="32" Height="32"
                                     Margin="2,0,14,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource AppsIconGeometry}"
                                      Fill="{DynamicResource TokenHeroPurpleFg}"/>
                            </Viewbox>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="TOTAL ASSETS" Style="{StaticResource TileLabel}"
                                           Foreground="{DynamicResource TokenHeroPurpleFg}"/>
                                <TextBlock Text="{Binding AssetCountDisplay}" Style="{StaticResource TileValue}"
                                           ToolTip="Tenant-wide assets (apps + flows + agents) from the Power Platform Inventory API. Click for breakdown by type."/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource StatusBadge}"
                                    Background="{DynamicResource TokenHeroPurpleBadgeBg}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="LIVE" Style="{StaticResource StatusBadgeText}"
                                           Foreground="{DynamicResource TokenHeroPurpleFg}"/>
                            </Border>
                        </Grid>
                    </Border>
                </Button>

                <!-- Tenant-wide license consumption rollup. Lights up after the
                     first env row-details load triggers the Graph fetch (or
                     when the user clicks the tile, which kicks off the fetch
                     directly). Click opens a drawer broken down by SKU. -->
                <Button Grid.Column="4" Style="{StaticResource HeroTileButton}"
                        AutomationProperties.AutomationId="HeroTileLicensedUsers"
                        AutomationProperties.Name="Licensed users tile"
                        Command="{Binding OpenDrawerCommand}" CommandParameter="licenses"
                        Margin="4">
                    <Border Style="{StaticResource TileBorder}"
                            Background="{DynamicResource TokenHeroBlueBg}"
                            BorderBrush="{DynamicResource TokenHeroBlueBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Person + shield glyph for identity / licensed users
                                 (Microsoft Graph licensing rollup). -->
                            <ui:SymbolIcon Grid.Column="0" Symbol="PersonAccounts24" FontSize="32"
                                           Foreground="{DynamicResource TokenHeroBlueFg}"
                                           Margin="2,0,14,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="LICENSED USERS" Style="{StaticResource TileLabel}"
                                           Foreground="{DynamicResource TokenHeroBlueFg}"/>
                                <TextBlock Text="{Binding LicensedUserCountDisplay}" Style="{StaticResource TileValue}"
                                           ToolTip="Distinct users with at least one Microsoft 365 / Power Platform license assigned (Microsoft Graph). Click for the SKU breakdown."/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource StatusBadge}"
                                    Background="{DynamicResource TokenHeroBlueBadgeBg}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="GRAPH" Style="{StaticResource StatusBadgeText}"
                                           Foreground="{DynamicResource TokenHeroBlueFg}"/>
                            </Border>
                        </Grid>
                    </Border>
                </Button>
            </Grid>

            <!-- Toolbar -->
            <Border Grid.Row="2" Background="{DynamicResource TokenSurfacePrimary}" BorderBrush="{DynamicResource TokenStrokeSubtle}" BorderThickness="1" CornerRadius="3" Padding="6" Margin="4,2">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Reload from cache" Style="{StaticResource ToolbarButton}"
                            AutomationProperties.AutomationId="ReloadFromCacheButton"
                            AutomationProperties.Name="Reload from cache"
                            Command="{Binding ReloadCommand}"
                            Background="{DynamicResource TokenNeutralPillBg}"
                            BorderBrush="{DynamicResource TokenNeutralPillBorder}"
                            ToolTip="Re-read the local SQLite catalog without calling PPAC."/>
                    <Button Content="Open trace log" Style="{StaticResource ToolbarButton}"
                            AutomationProperties.AutomationId="OpenTraceLogButton"
                            AutomationProperties.Name="Open trace log"
                            Command="{Binding OpenTraceLogCommand}"
                            Background="{DynamicResource TokenNeutralPillBg}"
                            BorderBrush="{DynamicResource TokenNeutralPillBorder}"
                            ToolTip="Open %LOCALAPPDATA%\VerseOps\inventory-trace.log (every HTTP request/response from the last refresh)."/>
                    <!-- Toggle: filter the env grid to envs the signed-in user is a Dataverse member of.
                         The first time this is checked we kick off a parallel WhoAmI probe per env;
                         envs are revealed as their probe succeeds, so the list grows monotonically. -->
                    <CheckBox Margin="14,0,0,0" VerticalAlignment="Center"
                              Foreground="{DynamicResource TokenTextPrimary}"
                              IsChecked="{Binding ShowOnlyMyEnvironments, Mode=TwoWay}"
                              Content="Only my environments"
                              ToolTip="Filter to environments where you have a Dataverse user record (issues a WhoAmI to each env on first toggle)."/>
                    <!-- Free-text search across every column the env grid header surfaces.
                         Tokens are AND-ed (whitespace-separated). Backed by EnvSearchText /
                         _envSearchTokens in InventoryViewModel.FilterEnvironment. The setter
                         debounces grid refresh on a 200 ms timer so each keystroke stays
                         fluid even on a 500-row grid. -->
                    <Grid Margin="14,0,0,0" VerticalAlignment="Center" Width="240">
                        <!-- Search is committed on Enter (or focus loss) so typing
                             stays buttery-smooth on large environment lists. The
                             previous PropertyChanged binding ran the filter on every
                             keystroke and made the box feel sluggish. -->
                        <TextBox x:Name="EnvSearchBox"
                                 AutomationProperties.AutomationId="EnvSearchBox"
                                 AutomationProperties.Name="Environment search"
                                 Text="{Binding EnvSearchText, UpdateSourceTrigger=Explicit}"
                                 KeyDown="EnvSearchBox_KeyDown"
                                 LostFocus="EnvSearchBox_LostFocus"
                                 TextChanged="EnvSearchBox_TextChanged"
                                 Background="{DynamicResource TokenSurfaceTertiary}"
                                 Foreground="{DynamicResource TokenTextPrimary}"
                                 BorderBrush="{DynamicResource TokenStrokeSubtle}"
                                 Padding="6,3,22,3"
                                 ToolTip="Search environments — name, sku, region, version, security group, owner, GUID, storage. Press Enter to apply. Tokens are AND-ed."/>
                        <!-- Watermark hides as soon as the box has either focus OR text.
                             A multi-data-trigger pattern keeps it simple: drop visibility
                             when EnvSearchBox.IsKeyboardFocusWithin OR HasEnvSearch. -->
                        <TextBlock Text="Search environments..."
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource TokenTextDisabled}"
                                   VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEnvSearch}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ElementName=EnvSearchBox, Path=IsKeyboardFocusWithin}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="✕" Width="18" Height="18" Padding="0"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                                Background="Transparent" BorderBrush="Transparent"
                                Foreground="{DynamicResource TokenTextSecondary}" Cursor="Hand"
                                Click="ClearEnvSearchButton_Click"
                                ToolTip="Clear search"
                                Visibility="{Binding HasEnvSearch, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                    <TextBlock Text="{Binding LastRefreshedDisplay}"
                               VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="{DynamicResource TokenBrandForeground}"/>
                    <!-- Per-column filter bulk-clear. Only visible when at least one
                         column funnel has a value; clears every per-column filter
                         in one click without touching the global env search. -->
                    <Button Margin="14,0,0,0" Padding="8,3" VerticalAlignment="Center"
                            Background="Transparent" BorderBrush="{DynamicResource TokenStrokeSubtle}"
                            Foreground="{DynamicResource TokenTextSecondary}" Cursor="Hand"
                            Command="{Binding ClearColumnFiltersCommand}"
                            ToolTip="Clear all per-column header filters."
                            Visibility="{Binding HasAnyColumnFilter, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE894;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Clear column filters" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ProgressBar Width="120" Height="6" Margin="14,0,0,0"
                                 VerticalAlignment="Center" IsIndeterminate="True"
                                 Background="{DynamicResource TokenSurfaceTertiary}" Foreground="{DynamicResource TokenBrandForeground}" BorderBrush="{DynamicResource TokenBrandBackground}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- Environments grid -->
            <DataGrid x:Name="EnvGrid" Grid.Row="3" Margin="4,2"
                      AutomationProperties.AutomationId="EnvironmentsGrid"
                      AutomationProperties.Name="Environments grid"
                      ItemsSource="{Binding EnvironmentsView}"
                      RowDetailsVisibilityMode="Visible"
                      SelectionChanged="EnvGrid_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="True"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.RowStyle>
                    <!-- Local RowStyle (BasedOn the implicit DataGridRow style
                         from App.xaml so we keep selection / hover triggers)
                         that pins MinHeight=40 so the 32 px circular chevron
                         pill always fits without being clipped at non-maximized
                         window sizes. Without this, rows defaulted to ~28-30 px
                         and the bottom of the pill got cut off, making it look
                         like the chevron only "showed up when maximized". -->
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="MinHeight" Value="40"/>
                    </Style>
                </DataGrid.RowStyle>
                <!-- Row visibility note: RowDetailsVisibilityMode is "Visible" so
                     the per-row details slot is *always* in the visual tree.
                     The actual content (the ScrollViewer in RowDetailsTemplate)
                     is only rendered when EnvironmentRow.IsExpanded is true.
                     Setting RowDetailsVisibilityMode="Collapsed" instead would
                     write a *local* DetailsVisibility=Collapsed on every row,
                     which beats any Style.Trigger we'd write (DependencyProperty
                     precedence: local > style trigger), so triggers wouldn't
                     win. Wrapping the inner ScrollViewer instead avoids that
                     trap entirely. -->
                <DataGrid.Columns>
                    <!-- Chevron toggle: collapses/expands the row-details panel.
                         Click also fires the per-env Dataverse drill-down on
                         first expansion (see EnvExpandToggle_Click). The icon
                         flips between right-facing (collapsed) and down-facing
                         (expanded) using a DataTrigger on IsExpanded.
                         Sized to Fluent v2 standard table-row affordance:
                         48 px column gutter + 28 px circular hit target +
                         18 px chevron glyph, leaving 10 px of even padding
                         on both sides so the disc sits centered in the
                         column without crowding the Name column on the right.
                         Pinned width (CanUserResize=False) because the user
                         shouldn't ever need to resize a single-purpose
                         affordance column. -->
                    <!-- Chevron column. Width must accommodate the implicit
                         DataGridCell.Padding="10,6" defined in App.xaml +
                         the 28 px circular hit-target inside, so we go to
                         56 px (10 + 28 + 10 + 8 slack) to guarantee the
                         disc is never sub-pixel-clipped on the first
                         layout pass. We also override CellStyle locally
                         to zero out that 10-px horizontal padding so the
                         disc sits dead-center in the column instead of
                         being shifted right by 10 px. Without these two
                         changes the chevron only appeared after a column-
                         splitter double-click forced a remeasure. -->
                    <DataGridTemplateColumn Width="56" MinWidth="56" CanUserResize="False" CanUserSort="False">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment"   Value="Center"/>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Style="{x:Null}" opts this Button OUT of the
                                     implicit App.xaml Button style — that style
                                     sets Margin="2", BorderThickness="1", and a
                                     custom Template that competes with our
                                     local Button.Template. On first paint the
                                     style cascade order was non-deterministic:
                                     sometimes the implicit Template won and
                                     the chevron disappeared until a window
                                     resize forced a remeasure. Opting out of
                                     the style cascade entirely makes the
                                     local Template win on every paint pass. -->
                                <Button Click="EnvExpandToggle_Click"
                                        Style="{x:Null}"
                                        Width="28" Height="28"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0"
                                        Cursor="Hand"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Focusable="False"
                                        SnapsToDevicePixels="True"
                                        ToolTip="Show / hide environment details">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <!-- 28 px circular hit-target with a soft brand
                                                 tint so the chevron is unmistakably a
                                                 button. Background darkens on hover and
                                                 deepens on press. -->
                                            <Border x:Name="Hit"
                                                    Width="28" Height="28"
                                                    CornerRadius="14"
                                                    Background="{DynamicResource TokenBrandBackground}"
                                                    BorderBrush="{DynamicResource TokenBrandStroke}"
                                                    BorderThickness="0"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Hit" Property="Background"
                                                            Value="{DynamicResource TokenBrandBackgroundHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Hit" Property="Background"
                                                            Value="{DynamicResource TokenBrandBackgroundPress}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <!-- Switch from a bare Segoe-Fluent text glyph to the
                                         Fluent v2 "chevron-in-a-circle" symbol icon. The
                                         circled chevron is a much stronger expand/collapse
                                         affordance than a bare arrow — it reads as a
                                         button at any zoom and stays visible against the
                                         row hover/selection brushes. -->
                                    <ui:SymbolIcon FontSize="18"
                                                   Foreground="White">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="ChevronCircleRight24"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Symbol" Value="ChevronCircleDown24"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Binding="{Binding DisplayName}"       Width="260">
                        <DataGridTextColumn.Header>
                            <local:ColumnFilterHeader Label="Name"
                                FilterText="{Binding DataContext.FilterName,    RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Sku}"               Width="110">
                        <DataGridTextColumn.Header>
                            <local:ColumnFilterHeader Label="SKU"
                                FilterText="{Binding DataContext.FilterSku,     RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ProvisioningState}" Width="110">
                        <DataGridTextColumn.Header>
                            <local:ColumnFilterHeader Label="Status"
                                FilterText="{Binding DataContext.FilterStatus,  RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Region}"            Width="110">
                        <DataGridTextColumn.Header>
                            <local:ColumnFilterHeader Label="Region"
                                FilterText="{Binding DataContext.FilterRegion,  RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Version}"           Width="120">
                        <DataGridTextColumn.Header>
                            <local:ColumnFilterHeader Label="Version"
                                FilterText="{Binding DataContext.FilterVersion, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- Managed Environment (premium governance). PPAC ProtectionLevel
                         == "Standard" means the env has Managed Environments turned on
                         (DLP enforced, sharing limits, request-access workflows, etc.). -->
                    <DataGridTemplateColumn Header="Managed" Width="70" SortMemberPath="IsManagedEnvironment">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip" Value="Power Platform 'Managed Environments' premium governance. Standard = on, Basic = off. Toggled per-env in the admin center."/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="6,1" CornerRadius="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{DynamicResource TokenSuccessBackground}"
                                        BorderBrush="{DynamicResource TokenSuccessForeground}"
                                        BorderThickness="1"
                                        Visibility="{Binding IsManagedEnvironment, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="MANAGED" Foreground="{DynamicResource TokenSuccessForeground}"
                                               FontSize="9" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Binding="{Binding CreatedUtc, StringFormat={}{0:yyyy-MM-dd}}" Width="100">
                        <DataGridTextColumn.Header>
                            <local:ColumnFilterHeader Label="Created"
                                FilterText="{Binding DataContext.FilterCreated, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- Security Group: Azure AD security group that gates env
                         access. SecurityGroupSummary returns "Open to all"
                         when no SG is attached, "{name}" once Graph resolved
                         the id, "{first8}…" while the resolve is pending,
                         and adds a ★ when the signed-in user is a transitive
                         member of the group. -->
                    <DataGridTextColumn Binding="{Binding SecurityGroupSummary}" Width="180">
                        <DataGridTextColumn.Header>
                            <local:ColumnFilterHeader Label="Security Group"
                                FilterText="{Binding DataContext.FilterSecurityGroup, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                ToolTip="Azure AD security group that gates env access. ★ marks groups the signed-in user is a transitive member of (drives the 'Only my envs' toggle)."/>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding SecurityGroupId}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Capacity columns: actual / limit GB with traffic-light
                         coloring. *Status returns "ok" / "warn" (>=80%) /
                         "over" (>=100%) and the DataTriggers tint the cell
                         red/amber. *GbDisplay handles formatting + the "—"
                         placeholder when no data is loaded. -->
                    <DataGridTemplateColumn Header="DB GB" Width="120" SortMemberPath="DatabaseGb">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip" Value="Database storage actual / rated capacity (Dataverse). Click the header to sort."/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DatabaseGbDisplay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CapacityCellText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DatabaseStatus}" Value="warn">
                                                    <Setter Property="Foreground" Value="{DynamicResource TokenWarningForeground}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DatabaseStatus}" Value="over">
                                                    <Setter Property="Foreground" Value="{DynamicResource TokenDangerForeground}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="File GB" Width="120" SortMemberPath="FileGb">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip" Value="File storage actual / rated capacity (Dataverse). Click the header to sort."/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileGbDisplay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CapacityCellText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FileStatus}" Value="warn">
                                                    <Setter Property="Foreground" Value="{DynamicResource TokenWarningForeground}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FileStatus}" Value="over">
                                                    <Setter Property="Foreground" Value="{DynamicResource TokenDangerForeground}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Log GB" Width="120" SortMemberPath="LogGb">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip" Value="Log storage actual / rated capacity (Dataverse). Click the header to sort."/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LogGbDisplay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CapacityCellText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LogStatus}" Value="warn">
                                                    <Setter Property="Foreground" Value="{DynamicResource TokenWarningForeground}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LogStatus}" Value="over">
                                                    <Setter Property="Foreground" Value="{DynamicResource TokenDangerForeground}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- FinOps capacity (Dynamics 365 Finance & Operations). Empty
                         "—" for non-FinOps envs so the column doesn't visually
                         imply they're at zero usage. Same status-trigger
                         coloring as the regular capacity columns. -->
                    <DataGridTemplateColumn Header="FinOps DB" Width="130" SortMemberPath="FinOpsDatabaseGb">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip" Value="FinOps (Dynamics 365 F&amp;O) database storage actual / rated capacity. Click the header to sort."/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FinOpsDatabaseGbDisplay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CapacityCellText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FinOpsDatabaseStatus}" Value="warn">
                                                    <Setter Property="Foreground" Value="{DynamicResource TokenWarningForeground}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FinOpsDatabaseStatus}" Value="over">
                                                    <Setter Property="Foreground" Value="{DynamicResource TokenDangerForeground}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="FinOps File" Width="130" SortMemberPath="FinOpsFileGb">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip" Value="FinOps (Dynamics 365 F&amp;O) file storage actual / rated capacity. Click the header to sort."/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FinOpsFileGbDisplay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CapacityCellText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FinOpsFileStatus}" Value="warn">
                                                    <Setter Property="Foreground" Value="{DynamicResource TokenWarningForeground}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FinOpsFileStatus}" Value="over">
                                                    <Setter Property="Foreground" Value="{DynamicResource TokenDangerForeground}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Apps / Flows / Agents counts moved out of the env grid
                         (they live on the per-env header inside the row
                         details panel). The asset totals are still visible
                         via the dashboard tiles at the top — keeping them
                         off the grid frees ~180px and lets the wider
                         Security Group / capacity / FinOps columns breathe. -->

                    <!-- Instance URL: copyable monospace text + browser launch.
                         Buttons collapse for envs without Dataverse (no URL).
                         Fixed width sized to fit a typical "https://orgxxxxx.crm.dynamics.com/"
                         (~36 chars) plus the two action icons; longer URLs scroll
                         inside the read-only TextBox via Ctrl+arrow / mouse drag. -->
                    <DataGridTemplateColumn Width="320" SortMemberPath="InstanceUrl">
                        <DataGridTemplateColumn.Header>
                            <local:ColumnFilterHeader Label="Instance URL"
                                FilterText="{Binding DataContext.FilterInstanceUrl, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True" Margin="2,0">
                                    <Button DockPanel.Dock="Right" Padding="4,0" Margin="2,0,0,0"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand"
                                            Foreground="{DynamicResource TokenBrandForeground}"
                                            ToolTip="Open instance URL in browser"
                                            Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding InstanceUrl}"
                                            Visibility="{Binding InstanceUrl, Converter={StaticResource StringToVisibility}}">
                                        <ui:SymbolIcon Symbol="Open24" FontSize="14"/>
                                    </Button>
                                    <Button DockPanel.Dock="Right" Padding="4,0" Margin="2,0,0,0"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand"
                                            Foreground="{DynamicResource TokenTextSecondary}"
                                            ToolTip="Copy instance URL"
                                            Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding InstanceUrl}"
                                            Visibility="{Binding InstanceUrl, Converter={StaticResource StringToVisibility}}">
                                        <ui:SymbolIcon Symbol="Copy24" FontSize="13"/>
                                    </Button>
                                    <TextBox Text="{Binding InstanceUrl, Mode=OneWay}" IsReadOnly="True"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TokenTextPrimary}"
                                             FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                             ToolTip="Click to select; Ctrl+C to copy"
                                             VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Env ID: copyable monospace + open-in-maker (env home).
                         The Open icon launches make.powerapps.com/environments/{id}/home;
                         the Copy icon copies the GUID.
                         Width="*" with MinWidth="280" so the column absorbs any
                         extra horizontal space — fixes the previous behaviour
                         where the env grid left a large empty band on the
                         right of the trailing column on wide screens. -->
                    <DataGridTemplateColumn Header="Env ID" Width="*" MinWidth="280" SortMemberPath="EnvId">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True" Margin="2,0">
                                    <Button DockPanel.Dock="Right" Padding="4,0" Margin="2,0,0,0"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand"
                                            Foreground="{DynamicResource TokenBrandForeground}"
                                            ToolTip="Open in maker portal (env home)"
                                            Command="{Binding DataContext.OpenEnvCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Open24" FontSize="14"/>
                                    </Button>
                                    <Button DockPanel.Dock="Right" Padding="4,0" Margin="2,0,0,0"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand"
                                            Foreground="{DynamicResource TokenTextSecondary}"
                                            ToolTip="Copy env id"
                                            Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding EnvId}">
                                        <ui:SymbolIcon Symbol="Copy24" FontSize="13"/>
                                    </Button>
                                    <TextBox Text="{Binding EnvId, Mode=OneWay}" IsReadOnly="True"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TokenTextPrimary}"
                                             FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                             ToolTip="Click to select; Ctrl+C to copy"
                                             VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

                <!-- ==========================================================
                     Per-env row-details template. Sections (vertical stack):
                       1.  Loading / error banner — only visible while the
                           Dataverse drill-down is in flight, or when it failed.
                       2.  Solutions parent — Expander rows; each solution
                           opens to reveal three multi-column DataGrids
                           (Apps / Flows / Agents). Lazy-loaded from the
                           Dataverse Web API on first row expand.
                       3.  Power Pages — sibling DataGrid showing every
                           mspp_website (or legacy adx_website) in this env.
                       4.  Users &amp; Groups — sibling DataGrid showing
                           non-disabled systemusers from Dataverse.
                     ========================================================== -->
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <!-- Bounded ScrollViewer so an expanded env's deep-dive
                             content (Solutions / Power Pages / Users sub-grids,
                             which can be large) doesn't push the rest of the
                             env grid rows below the fold. The user can still
                             see the env list AND scroll through the details.
                             Visibility is bound to EnvironmentRow.IsExpanded
                             (toggled by the chevron in the leading column);
                             when collapsed the ScrollViewer takes zero height
                             so the row footprint matches a non-expanded row.

                             Width is pinned to the DataGrid's visible viewport
                             via the ScrollContentPresenter ancestor. Without
                             this, the row-details panel inherits the *full row
                             width* (sum of every env-grid column ≈ 2000px), so
                             every nested sub-grid stretched past the visible
                             viewport — the user was forced to horizontally
                             scroll the ENTIRE env grid just to see the right
                             half of an Apps/Flows/Agents grid. With the cap,
                             each inner DataGrid honours its own
                             HorizontalScrollBarVisibility="Auto" and scrolls
                             independently. HorizontalAlignment="Left" anchors
                             the panel to the left edge so it doesn't drift as
                             the env grid scrolls horizontally for *its* own
                             columns. -->
                        <!-- Width AND MaxHeight are both pinned to the env
                             DataGrid's visible viewport (ScrollContentPresenter
                             ancestor). The width pin keeps inner sub-grids
                             from inheriting the full row width (sum of every
                             env-grid column ≈ 2000px), and the height pin
                             lets the row-details panel grow to fill all the
                             vertical real estate that focus mode just freed
                             up by hiding the other env rows. The 36 px
                             subtraction reserves space for the env row
                             header that sits above the details panel so the
                             panel doesn't push past the visible viewport.
                             We use ScrollContentPresenter (not the
                             DataGrid itself) so the binding survives the
                             outer page ScrollViewer wrapping the InventoryView. -->
                        <ScrollViewer MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ScrollContentPresenter}}, Converter={StaticResource SubtractDouble}, ConverterParameter=36}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      HorizontalAlignment="Left"
                                      Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ScrollContentPresenter}}}"
                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"
                                      PreviewMouseWheel="DetailsScrollViewer_PreviewMouseWheel">
                            <!-- Visual frame for the expanded row-details panel:
                                 thick brand-blue left accent bar + distinct
                                 surface tint + bold top/bottom rules so the
                                 user can clearly see where the env's drill-
                                 down begins and ends amongst the surrounding
                                 env rows. The chevron in the leading column
                                 visually "anchors" to this frame. -->
                            <Border Background="{DynamicResource TokenSurfaceSecondary}"
                                    BorderBrush="{DynamicResource TokenBrandBackground}"
                                    BorderThickness="4,2,1,2"
                                    Padding="14,12" Margin="0,2,0,6"
                                    CornerRadius="0,4,4,0">
                                <StackPanel>
                                <!-- Header: env totals summary line + cache-age badge + Refresh button.
                                     The Refresh button force-re-fetches THIS env's Dataverse
                                     drill-down (drops the SQLite snapshot, hits Dataverse fresh,
                                     persists the new snapshot). All other expansions of this row
                                     hydrate instantly from the cached snapshot — that's what makes
                                     the second/third expand feel instant. -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="ENV ASSETS" Foreground="{DynamicResource TokenBrandForeground}"
                                                   FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text="â€¢" Foreground="{DynamicResource TokenStrokeSubtle}" Margin="8,0" VerticalAlignment="Center"/>
                                        <TextBlock Foreground="{DynamicResource TokenBrandForeground}" FontSize="11" VerticalAlignment="Center">
                                            <Run Text="{Binding AppCount, Mode=OneWay}"/><Run Text=" Apps "/>
                                            <Run Text="â€¢" Foreground="{DynamicResource TokenStrokeSubtle}"/>
                                            <Run Text=" "/><Run Text="{Binding FlowCount, Mode=OneWay}"/><Run Text=" Flows "/>
                                            <Run Text="â€¢" Foreground="{DynamicResource TokenStrokeSubtle}"/>
                                            <Run Text=" "/><Run Text="{Binding AgentCount, Mode=OneWay}"/><Run Text=" Agents"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <!-- Cache-age badge — shown after first successful load. Reads
                                         "Cached: 5m ago" / "Cached: 2h ago" / "Cached: 2026-05-04 16:22 UTC".
                                         Updated whenever DetailsLastSyncedUtc INPCs (i.e. on first load
                                         and after every Refresh click). -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DetailsLastSyncedDisplay}"
                                               Foreground="{DynamicResource TokenTextSecondary}"
                                               FontSize="11" VerticalAlignment="Center"
                                               Margin="0,0,12,0"
                                               Visibility="{Binding HasDetailsLastSynced, Converter={StaticResource BoolToVisibility}}"/>
                                    <!-- Refresh button — force re-fetch of this env's Dataverse
                                         drill-down. Disabled while a fetch is in flight.
                                         Uses the same Info pill chrome as the title-bar
                                         Refresh so the action affordance is consistent and
                                         the hit target is large + obvious (no muted
                                         ui:Button "Secondary" styling that disappears into
                                         the row). -->
                                    <Button Grid.Column="3"
                                            Style="{StaticResource ToolbarButton}"
                                            AutomationProperties.AutomationId="EnvRefreshButton"
                                            AutomationProperties.Name="Refresh environment details"
                                            Command="{Binding DataContext.RefreshEnvDetailsCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:InventoryView}}}"
                                            CommandParameter="{Binding}"
                                            Background="{DynamicResource TokenHeaderPillInfoBg}"
                                            BorderBrush="{DynamicResource TokenHeaderPillInfoBorder}"
                                            Foreground="{DynamicResource TokenHeaderPillInfoFg}"
                                            Padding="14,0" FontSize="12" FontWeight="SemiBold"
                                            Height="30" MinWidth="100"
                                            VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Cursor="Hand"
                                            ToolTip="Re-fetch this environment's solutions, Power Pages, users, and per-asset enrichments from Dataverse and overwrite the local cache.">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Refresh" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Loading banner: visible while we fetch Dataverse details -->
                                <Border Background="{DynamicResource TokenInfoBackground}" BorderBrush="{DynamicResource TokenBrandBackground}" BorderThickness="1"
                                        CornerRadius="3" Padding="10,8" Margin="0,0,0,10"
                                        Visibility="{Binding IsLoadingDetails, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ProgressBar Width="120" Height="6" IsIndeterminate="True"
                                                     Background="{DynamicResource TokenSurfaceTertiary}" Foreground="{DynamicResource TokenBrandForeground}"
                                                     BorderBrush="{DynamicResource TokenBrandBackground}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Loading per-env details from Dataverse (solutions, Power Pages, users, asset status)â€¦"
                                                   Foreground="{DynamicResource TokenBrandForeground}" FontSize="11" Margin="10,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Error banner: visible if Dataverse fetch failed -->
                                <Border Background="{DynamicResource TokenDangerBackground}" BorderBrush="{DynamicResource TokenDangerBackground}" BorderThickness="1"
                                        CornerRadius="3" Padding="10,8" Margin="0,0,0,10"
                                        Visibility="{Binding HasDetailsError, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Could not load per-env details" Foreground="{DynamicResource TokenDangerForeground}"
                                                   FontWeight="SemiBold" FontSize="11"/>
                                        <TextBlock Text="{Binding DetailsError}" Foreground="{DynamicResource TokenDangerForeground}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- ============================================
                                     View-mode toggle. The user picks how
                                     this env's apps / flows / agents are
                                     organized inside the row-details panel:
                                       â€¢ Group by Solution — Solutions
                                         Expander (default).
                                       â€¢ Flat — three sibling DataGrids
                                         (Apps / Flows / Agents) showing
                                         every asset in the env, ungrouped.
                                     Power Pages and Users sections are
                                     always shown below regardless of mode.
                                     ============================================ -->
                                <Border Background="{DynamicResource TokenSurfaceSecondary}" BorderBrush="{DynamicResource TokenStrokeSubtle}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="8,6" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="VIEW" Foreground="{DynamicResource TokenBrandForeground}" FontSize="10"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Margin="2,0,12,0"/>
                                        <RadioButton Content="Group by Solution"
                                                     IsChecked="{Binding IsSolutionsView, Mode=OneWay}"
                                                     Foreground="{DynamicResource TokenTextPrimary}" FontSize="11"
                                                     VerticalAlignment="Center" Margin="0,0,18,0"
                                                     Cursor="Hand"
                                                     Tag="solutions"
                                                     Click="ViewModeRadio_Click"
                                                     ToolTip="Show Apps / Flows / Agents grouped under their owning Dataverse solution."/>
                                        <RadioButton Content="Flat — Apps / Flows / Agents"
                                                     IsChecked="{Binding IsFlatView, Mode=OneWay}"
                                                     Foreground="{DynamicResource TokenTextPrimary}" FontSize="11"
                                                     VerticalAlignment="Center"
                                                     Cursor="Hand"
                                                     Tag="flat"
                                                     Click="ViewModeRadio_Click"
                                                     ToolTip="Show every asset in this env in three flat sibling grids, ignoring solution membership."/>
                                    </StackPanel>
                                </Border>

                                <!-- ============================================
                                     SECTION 1 — Solutions (parent grid).
                                     Each solution row is an Expander whose
                                     content is the nested Apps / Flows /
                                     Agents DataGrids for that solution.
                                     ============================================ -->
                                <Border Background="{DynamicResource TokenSurfaceSecondary}" BorderBrush="{DynamicResource TokenStrokeSubtle}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="10" Margin="0,0,0,10"
                                        Visibility="{Binding IsSolutionsView, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Viewbox Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource SolutionsIconGeometry}"
                                                          Fill="{DynamicResource TokenBrandForeground}"/>
                                                </Viewbox>
                                                <TextBlock Text="SOLUTIONS"
                                                           Foreground="{DynamicResource TokenBrandForeground}" FontWeight="SemiBold" FontSize="10"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TokenTextTertiary}" FontSize="10"
                                                       Text="{Binding SolutionCount, StringFormat={}{0} solution(s) — Dataverse}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Solutions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Expander Style="{StaticResource SolutionExpander}">
                                                        <Expander.Header>
                                                            <Grid Width="900" HorizontalAlignment="Stretch">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TokenTextPrimary}"
                                                                               FontWeight="SemiBold" FontSize="13"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Publisher}"
                                                                               Foreground="{DynamicResource TokenTextTertiary}" FontSize="10"
                                                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                                    <Border Background="#5B2E91" CornerRadius="8"
                                                                            Padding="6,1" Margin="8,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding IsManaged, Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBlock Text="MANAGED" Foreground="White"
                                                                                   FontSize="9" FontWeight="SemiBold"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Version}"
                                                                               Foreground="{DynamicResource TokenTextTertiary}" FontSize="10"
                                                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="1" Background="{DynamicResource TokenBrandBackground}" CornerRadius="10"
                                                                        Padding="10,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding Summary}"
                                                                               Foreground="{DynamicResource TokenTextOnAccent}" FontSize="10"
                                                                               FontWeight="SemiBold"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource OpenInMakerIconButton}"                                                                                                                                                        Command="{Binding DataContext.OpenInMakerCommand, RelativeSource={RelativeSource AncestorType={x:Type local:InventoryView}}}"
                                                                            CommandParameter="{Binding}"/>
                                                                    <Button Style="{StaticResource InspectJsonIconButton}"                                                                                                                                                        Command="{Binding DataContext.InspectJsonCommand, RelativeSource={RelativeSource AncestorType={x:Type local:InventoryView}}}"
                                                                            CommandParameter="{Binding}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Expander.Header>

                                                        <!-- Nested Apps / Flows / Agents grids stacked vertically -->
                                                        <StackPanel Margin="6,8,0,4">
                                                            <!-- Apps grid -->
                                                            <Border Background="{DynamicResource TokenSurfaceSubtle}" BorderBrush="{DynamicResource TokenStrokeSubtle}"
                                                                    BorderThickness="1" CornerRadius="3"
                                                                    Padding="8" Margin="0,0,0,6">
                                                                <DockPanel>
                                                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Viewbox Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                <Path Data="{StaticResource AppsIconGeometry}"
                                                                                      Fill="{DynamicResource TokenBrandForeground}"/>
                                                                            </Viewbox>
                                                                            <TextBlock Text="APPS"
                                                                                       Style="{StaticResource AssetSectionLabel}"/>
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                                                                   Foreground="{DynamicResource TokenTextTertiary}" FontSize="10"
                                                                                   Text="{Binding AppCount, StringFormat={}{0} item(s)}"/>
                                                                    </Grid>
                                                                    <local:PagedDataGrid ItemsSource="{Binding Apps}" PageSize="10" MaxHeight="280">
                                                                            <DataGridTextColumn Header="Name"        Binding="{Binding DisplayName}" Width="260"/>
                                                                            <DataGridTextColumn Header="Type"        Binding="{Binding TypeDisplay}" Width="110"/>
                                                                            <DataGridTextColumn Header="Status"      Binding="{Binding Status, TargetNullValue=—}" Width="80"/>
                                                                            <DataGridTextColumn Header="ALM"         Binding="{Binding ManagedDisplay}" Width="90"/>
                                                                            <DataGridTextColumn Header="Premium"     Binding="{Binding PremiumDisplay}" Width="80"/>
                                                                            <DataGridTextColumn Header="DLP"         Binding="{Binding DlpStatus, TargetNullValue=—}" Width="90"/>
                                                                            <DataGridTextColumn Header="Owner"       Binding="{Binding OwnerDisplay}"     Width="180"/>
                                                                            <DataGridTextColumn Header="Created"     Binding="{Binding CreatedUtc,  StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                                                                            <DataGridTextColumn Header="Modified"    Binding="{Binding ModifiedUtc, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                                                                            <DataGridCheckBoxColumn Header="Quarantined" Binding="{Binding IsQuarantined}" Width="80"/>
                                                                            <DataGridTextColumn Header="Region"      Binding="{Binding Region}"      Width="100"/>
                                                                            <DataGridTemplateColumn Header="Actions" Width="90">
                                                                                <DataGridTemplateColumn.CellTemplate>
                                                                                    <DataTemplate>
                                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                            <Button Style="{StaticResource OpenInMakerIconButton}"                                                                                                                                                                                                        Command="{Binding DataContext.OpenInMakerCommand, RelativeSource={RelativeSource AncestorType={x:Type local:InventoryView}}}"
                                                                                                    CommandParameter="{Binding}"/>
                                                                                            <Button Style="{StaticResource InspectJsonIconButton}"                                                                                                                                                                                                        Command="{Binding DataContext.InspectJsonCommand, RelativeSource={RelativeSource AncestorType={x:Type local:InventoryView}}}"
                                                                                                    CommandParameter="{Binding}"/>
                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </DataGridTemplateColumn.CellTemplate>
                                                                            </DataGridTemplateColumn>
                                                                    </local:PagedDataGrid>
                                                                </DockPanel>
                                                            </Border>

                                                            <!-- Flows grid -->
                                                            <Border Background="{DynamicResource TokenSurfaceSubtle}" BorderBrush="{DynamicResource TokenStrokeSubtle}"
                                                                    BorderThickness="1" CornerRadius="3"
                                                                    Padding="8" Margin="0,0,0,6">
                                                                <DockPanel>
                                                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Viewbox Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                <Path Data="{StaticResource FlowsIconGeometry}"
                                                                                      Fill="{DynamicResource TokenBrandForeground}"/>
                                                                            </Viewbox>
                                                                            <TextBlock Text="FLOWS"
                                                                                       Style="{StaticResource AssetSectionLabel}"/>
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                                                                   Foreground="{DynamicResource TokenTextTertiary}" FontSize="10"
                                                                                   Text="{Binding FlowCount, StringFormat={}{0} item(s)}"/>
                                                                    </Grid>
                                                                    <local:PagedDataGrid ItemsSource="{Binding Flows}" PageSize="10" MaxHeight="280">
                                                                            <DataGridTextColumn Header="Name"     Binding="{Binding DisplayName}" Width="260"/>
                                                                            <DataGridTextColumn Header="Type"     Binding="{Binding TypeDisplay}" Width="110"/>
                                                                            <DataGridTextColumn Header="Status"   Binding="{Binding Status, TargetNullValue=—}" Width="80"/>
                                                                            <DataGridTextColumn Header="ALM"      Binding="{Binding ManagedDisplay}" Width="90"/>
                                                                            <DataGridTextColumn Header="Premium"  Binding="{Binding PremiumDisplay}" Width="80"/>
                                                                            <DataGridTextColumn Header="DLP"      Binding="{Binding DlpStatus, TargetNullValue=—}" Width="90"/>
                                                                            <DataGridTextColumn Header="Owner"    Binding="{Binding OwnerDisplay}"     Width="180"/>
                                                                            <DataGridTextColumn Header="Created"  Binding="{Binding CreatedUtc,  StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                                                                            <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedUtc, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                                                                            <DataGridTextColumn Header="Region"   Binding="{Binding Region}"      Width="100"/>
                                                                            <DataGridTemplateColumn Header="Actions" Width="90">
                                                                                <DataGridTemplateColumn.CellTemplate>
                                                                                    <DataTemplate>
                                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                            <Button Style="{StaticResource OpenInMakerIconButton}"                                                                                                                                                                                                        Command="{Binding DataContext.OpenInMakerCommand, RelativeSource={RelativeSource AncestorType={x:Type local:InventoryView}}}"
                                                                                                    CommandParameter="{Binding}"/>
                                                                                            <Button Style="{StaticResource InspectJsonIconButton}"                                                                                                                                                                                                        Command="{Binding DataContext.InspectJsonCommand, RelativeSource={RelativeSource AncestorType={x:Type local:InventoryView}}}"

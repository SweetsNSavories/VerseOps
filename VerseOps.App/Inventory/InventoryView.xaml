                            </StackPanel>
                        </Border>
                        </ScrollViewer>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>

            <!-- Status bar -->
            <Border Grid.Row="4" Background="{DynamicResource TokenBrandBackground}" Padding="6,3" Margin="4,2,4,0">
                <TextBlock Foreground="White" VerticalAlignment="Center"
                           Text="{Binding StatusText}"/>
            </Border>

            <!-- Error panel (collapsed when no error) -->
            <Border Grid.Row="5" Margin="4,4,4,0" Padding="8" CornerRadius="3"
                    Background="{DynamicResource TokenDangerBackground}" BorderBrush="{DynamicResource TokenDangerBackground}" BorderThickness="1"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Last error" Foreground="{DynamicResource TokenDangerForeground}"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Copy"
                                    Command="{Binding CopyErrorCommand}"
                                    Background="{DynamicResource TokenDangerBackground}" BorderBrush="{DynamicResource TokenDangerBackground}" Foreground="White"
                                    Padding="10,2" Margin="2,0" Cursor="Hand"
                                    ToolTip="Copy the full error text (exception chain + HTTP body) to the clipboard."/>
                            <Button Content="Open trace log"
                                    Command="{Binding OpenTraceLogCommand}"
                                    Background="#3A3A3D" BorderBrush="#555" Foreground="White"
                                    Padding="10,2" Margin="2,0" Cursor="Hand"
                                    ToolTip="Open the full request/response trace file."/>
                        </StackPanel>
                    </Grid>
                    <TextBox Text="{Binding LastError, Mode=OneWay}"
                             IsReadOnly="True" Background="Transparent"
                             Foreground="{DynamicResource TokenDangerForeground}" BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas" FontSize="11"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             MaxHeight="220"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ==================================================================
             RIGHT-SIDE SLIDE-IN DRAWER (PCF "DLP Policies" pattern).
             Click any hero KPI tile to open. Click the dim overlay or Ã— to close.
             ================================================================== -->
        <Grid Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVisibility}}">
            <!-- Dim overlay (tap-to-close) -->
            <Button Background="#80000000" BorderThickness="0"
                    Command="{Binding CloseDrawerCommand}" Cursor="Arrow"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Drawer panel -->
            <Border HorizontalAlignment="Right" Width="460"
                    Background="{DynamicResource TokenSurfacePrimary}" BorderBrush="{DynamicResource TokenStrokeSubtle}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <!-- Drawer header -->
                    <Border DockPanel.Dock="Top" Padding="18,14" Background="{DynamicResource TokenSurfaceSubtle}"
                            BorderBrush="{DynamicResource TokenStrokeSubtle}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DrawerTitle}" Foreground="White"
                                           FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding DrawerSubtitle}" Foreground="{DynamicResource TokenTextSecondary}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Ã—"
                                    Command="{Binding CloseDrawerCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource TokenTextSecondary}" FontSize="20" Padding="8,0"
                                    Cursor="Hand" VerticalAlignment="Top"
                                    ToolTip="Close (Esc)"/>
                        </Grid>
                    </Border>

                    <!-- Drawer item list -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <ItemsControl ItemsSource="{Binding DrawerItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource TokenSurfaceSecondary}" BorderBrush="{DynamicResource TokenStrokeSubtle}" BorderThickness="1"
                                            CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" Foreground="White"
                                                           FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TokenTextSecondary}"
                                                           FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#1F5A40"
                                                    CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Badge}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Badge}"
                                                           Style="{StaticResource StatusBadgeText}"
                                                           Foreground="#7DD9A6"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

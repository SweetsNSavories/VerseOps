                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource TokenTextSecondary}" FontSize="20" Padding="8,0"
                                    Cursor="Hand" VerticalAlignment="Top"
                                    ToolTip="Close (Esc)"/>
                        </Grid>
                    </Border>

                    <!-- Drawer item list -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <ItemsControl ItemsSource="{Binding DrawerItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource TokenSurfaceSecondary}" BorderBrush="{DynamicResource TokenStrokeSubtle}" BorderThickness="1"
                                            CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <!-- License / SKU NAME. Uses a hardcoded near-black so it is
                                                     readable regardless of any DynamicResource resolution order
                                                     in the drawer. Bumped to 14pt Bold to dominate the row -
                                                     admins scan this column to recognise the SKU at a glance. -->
                                                <TextBlock Text="{Binding Title}" Foreground="#1B1B1B"
                                                           FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="{Binding Subtitle}" Foreground="#424242"
                                                           FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#107C41"
                                                    CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Badge}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Badge}"
                                                           Style="{StaticResource StatusBadgeText}"
                                                           Foreground="White"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

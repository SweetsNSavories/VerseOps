<ui:FluentWindow x:Class="VerseOps.App.Inventory.MetadataInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Metadata Inspector"
        Background="{DynamicResource TokenSurfaceCanvas}"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Width="900" Height="640"
        MinWidth="540" MinHeight="320">

    <Window.Resources>
        <Style TargetType="Button" x:Key="DialogButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Fluent title bar replaces the default OS chrome. -->
        <ui:TitleBar DockPanel.Dock="Top" Title="Metadata Inspector"
                     ShowMaximize="False" ShowMinimize="False"/>

        <!-- Header chip + subtitle -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource TokenSurfaceSubtle}"
                Padding="20,16"
                BorderBrush="{DynamicResource TokenStrokeSubtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource TokenBrandBackground}"
                        CornerRadius="6" Width="36" Height="36" VerticalAlignment="Center">
                    <TextBlock Text="{}{ }"
                               Foreground="{DynamicResource TokenTextOnAccent}"
                               FontWeight="Bold" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Metadata Inspector"
                               Foreground="{DynamicResource TokenTextPrimary}"
                               FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="HeaderSubtitle"
                               Foreground="{DynamicResource TokenTextTertiary}"
                               FontSize="11" Margin="0,3,0,0"
                               Text="Technical JSON schema"/>
                </StackPanel>
                <Button Grid.Column="2" Content="×" x:Name="CloseHeaderBtn"
                        Style="{StaticResource SubtleButton}"
                        FontSize="20" Padding="10,0"
                        VerticalAlignment="Top"
                        ToolTip="Close (Esc)" Click="OnDismiss"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource TokenSurfaceSubtle}"
                Padding="20,12"
                BorderBrush="{DynamicResource TokenStrokeSubtle}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="CaptureLabel"
                           Foreground="{DynamicResource TokenTextTertiary}"
                           FontSize="11" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Copy JSON"
                            Style="{StaticResource AccentButton}"
                            Padding="14,7" MinWidth="92" FontSize="12"
                            Margin="0,0,10,0" Click="OnCopy"/>
                    <Button Content="Open in Maker"
                            x:Name="OpenMakerBtn"
                            Style="{StaticResource DialogButton}"
                            Margin="0,0,10,0" Click="OnOpenMaker"/>
                    <Button Content="Dismiss"
                            Style="{StaticResource SubtleButton}"
                            Padding="14,7" MinWidth="92" FontSize="12"
                            Click="OnDismiss" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- JSON viewer -->
        <Border Background="{DynamicResource TokenCodeBackground}" Padding="0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="JsonBox"
                         Background="Transparent"
                         Foreground="{DynamicResource TokenCodeKeyword}"
                         FontFamily="{DynamicResource TokenFontFamilyMono}"
                         FontSize="12"
                         BorderThickness="0"
                         IsReadOnly="True"
                         Padding="20,16"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Disabled"
                         HorizontalScrollBarVisibility="Disabled"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</ui:FluentWindow>

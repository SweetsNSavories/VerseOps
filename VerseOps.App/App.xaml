<Application x:Class="VerseOps.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:VerseOps.App"
             StartupUri="MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>
            <!--  ====================================================
                  Theme dictionaries (WPF-UI = Fluent 2 / Fluent React)
                  ControlsDictionary supplies the ui:* control templates;
                  the active ThemesDictionary (Dark/Light) is *applied at
                  runtime* by App.xaml.cs via ApplicationThemeManager.Apply
                  so we can swap themes without restarting.

                  Our own semantic Token brushes live in Themes/Tokens.*.xaml.
                  Tokens.Dark.xaml is the boot default; App.xaml.cs swaps
                  it out for Tokens.Light.xaml when the user (or system)
                  toggles to the light theme.
                  ====================================================  -->
            <ResourceDictionary.MergedDictionaries>
                <ui:ControlsDictionary/>
                <!-- Light-only build: VerseOps locks to Fluent v2 Light. The
                     dark dictionary is no longer merged at boot and the in-app
                     theme toggle is a no-op (kept hidden in the header). -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Tokens.Light.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--  ====================================================
                  Implicit Fluent styles for stock WPF controls.
                  Every Window / UserControl picks these up automatically;
                  no per-element opt-in needed. Local x:Key styles in views
                  override these where finer control is required.
                  ====================================================  -->

            <!-- ============================================================
                 Always-visible scroll bars. WPF-UI's ControlsDictionary
                 swaps the stock ScrollBar template for a "DynamicScrollBar"
                 that hides the thumb 1000ms after the mouse leaves the bar
                 (IsInteracted ↔ IsMouseOver, see DynamicScrollBar.cs in
                 lepoco/wpfui). Users perceived this as "scrollbars are
                 missing" because the bar is invisible until you hover the
                 right edge of the grid. We override with a classic Fluent
                 always-visible thumb (constant 12 px wide, no fade) so
                 every DataGrid / ScrollViewer in the app has a discoverable
                 vertical scrollbar at all times.
                 ============================================================ -->
            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenStrokeAccessible}"/>
                <Setter Property="Width" Value="12"/>
                <Setter Property="MinWidth" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid x:Name="Bg" Background="{DynamicResource TokenSurfaceSecondary}"
                                  SnapsToDevicePixels="True">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Style>
                                                <Style TargetType="{x:Type Thumb}">
                                                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                    <Setter Property="Background" Value="{DynamicResource TokenStrokeAccessible}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                                <Border CornerRadius="6"
                                                                        Background="{TemplateBinding Background}"
                                                                        Margin="2"/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource TokenTextSecondary}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                      Background="Transparent" BorderBrush="Transparent"
                                                      Focusable="False" IsTabStop="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                      Background="Transparent" BorderBrush="Transparent"
                                                      Focusable="False" IsTabStop="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Height" Value="12"/>
                        <Setter Property="MinHeight" Value="12"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{DynamicResource TokenTextSecondary}"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontSize" Value="{DynamicResource TokenFontSizeBody1}"/>
                <Setter Property="Padding" Value="0,4,8,4"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontSize" Value="{DynamicResource TokenFontSizeBody1}"/>
            </Style>

            <!-- ToolTip global style.
                 Default WPF ToolTip uses system colors that look fine on a
                 plain Win32 surface but turn nearly transparent on a Mica
                 FluentWindow — the tooltip backdrop becomes the desktop
                 wallpaper and the text reads invisibly until the cursor
                 actually enters the tip's hit-rect (which forces a
                 re-render with the system Highlight). Pin opaque token
                 brushes + a real border so tooltips are always legible
                 on first paint regardless of theme. -->
            <Style TargetType="ToolTip">
                <Setter Property="Background"      Value="{DynamicResource TokenSurfacePrimary}"/>
                <Setter Property="Foreground"      Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource TokenStrokeDefault}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"         Value="10,6"/>
                <Setter Property="FontFamily"      Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontSize"        Value="{DynamicResource TokenFontSizeBody1}"/>
                <Setter Property="HasDropShadow"   Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    TextElement.Foreground="{TemplateBinding Foreground}"
                                    TextElement.FontFamily="{TemplateBinding FontFamily}"
                                    TextElement.FontSize="{TemplateBinding FontSize}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource TokenSurfaceSecondary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeDefault}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TokenBrandForeground}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource TokenBrandBackground}"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontSize" Value="{DynamicResource TokenFontSizeBody1}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TokenStrokeAccessible}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TokenBrandStroke}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TokenTextDisabled}"/>
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource TokenSurfaceSecondary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeDefault}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TokenBrandForeground}"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource TokenSurfaceTertiary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeDefault}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontSize" Value="{DynamicResource TokenFontSizeBody1}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource TokenSurfaceSecondary}"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TokenStrokeAccessible}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource TokenSurfacePrimary}"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TokenStrokeDefault}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary (Brand) button — opt-in via Style="{StaticResource AccentButton}" -->
            <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{DynamicResource TokenBrandBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextOnAccent}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenBrandBackground}"/>
            </Style>

            <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextSecondary}"/>
            </Style>

            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{DynamicResource TokenDangerBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenDangerBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextOnAccent}"/>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource TokenSurfaceSecondary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeDefault}"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontSize" Value="{DynamicResource TokenFontSizeBody1}"/>
            </Style>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="{DynamicResource TokenSurfacePrimary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="Padding" Value="8,4"/>
                <!-- Default WPF ComboBoxItem template uses SystemColors.HighlightTextBrush
                     on selection / hover, which is white. On our brand-tinted highlight
                     that renders as white-on-light-blue and the value disappears. Pin
                     the foreground to TokenTextPrimary in every visual state so the
                     selected page-size (and any other ComboBox) stays readable. -->
                <Style.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TokenBrandBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TokenTextOnAccent}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TokenBrandBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TokenTextOnAccent}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TokenSurfaceSecondary}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontSize" Value="{DynamicResource TokenFontSizeBody1}"/>
                <Setter Property="Margin" Value="6,2"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontSize" Value="{DynamicResource TokenFontSizeBody1}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="GroupBox">
                <Setter Property="Background" Value="{DynamicResource TokenSurfacePrimary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenBrandForeground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Padding="12,8,12,4">
                                        <ContentPresenter ContentSource="Header"
                                                          TextElement.Foreground="{DynamicResource TokenBrandForeground}"
                                                          TextElement.FontWeight="SemiBold"
                                                          TextElement.FontSize="{DynamicResource TokenFontSizeBody1}"/>
                                    </Border>
                                    <Border Grid.Row="1" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>

            <Style TargetType="TabItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextSecondary}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontSize" Value="{DynamicResource TokenFontSizeBody1}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="root" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ContentPresenter Grid.Row="0"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <Border Grid.Row="1" x:Name="indicator"
                                            Height="2" CornerRadius="1"
                                            Margin="6,4,6,0"
                                            Background="Transparent"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TokenBrandForeground}"/>
                                    <Setter TargetName="indicator" Property="Background" Value="{DynamicResource TokenBrandBackground}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="root" Property="Background" Value="{DynamicResource TokenSurfaceSecondary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="{DynamicResource TokenSurfacePrimary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
                <Setter Property="VerticalGridLinesBrush"   Value="{DynamicResource TokenStrokeSubtle}"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource TokenSurfaceSecondary}"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontSize" Value="{DynamicResource TokenFontSizeBody1}"/>
            </Style>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource TokenSurfaceSubtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="{DynamicResource TokenFontSizeCaption1}"/>
            </Style>
            <Style TargetType="DataGridRow">
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TokenSurfaceTertiary}"/>
                    </Trigger>
                    <!-- Selection: subtle brand tint, NOT a saturated fill.
                         Inner cells (capacity GB, URLs, danger / warning text)
                         have their own explicit Foreground bindings that beat
                         a row-level Foreground override (DependencyProperty
                         precedence). A dark-blue selection background made all
                         that text invisible. The light tint keeps every cell
                         legible while still showing 'this row is selected'.
                         We MUST also pin Foreground to TokenTextPrimary on
                         selection — otherwise plain-text columns (Name, SKU,
                         Status, Region) inherit the system Highlight foreground
                         (white) from a default trigger somewhere upstream and
                         become invisible on the pale-blue selection tint. -->
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TokenBrandSelectionSubtle}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- Same reason as DataGridRow.IsSelected above: keep cell
                         text dark on the pale selection tint. -->
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="TreeView">
                <Setter Property="Background" Value="{DynamicResource TokenSurfacePrimary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
            </Style>
            <Style TargetType="TreeViewItem">
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="2"/>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsSelected" Value="True"/>
                            <Condition Property="IsSelectionActive" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource TokenBrandSelectionSubtle}"/>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsSelected" Value="True"/>
                            <Condition Property="IsSelectionActive" Value="False"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource TokenSurfaceTertiary}"/>
                    </MultiTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TokenSurfaceSecondary}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ProgressBar">
                <Setter Property="Background" Value="{DynamicResource TokenSurfaceTertiary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenBrandBackground}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Height" Value="4"/>
            </Style>

            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="Background" Value="{DynamicResource TokenSurfaceSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
            </Style>

            <!-- Reusable Fluent card surfaces -->
            <Style x:Key="FluentCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource TokenSurfacePrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="14"/>
            </Style>
            <Style x:Key="FluentCardSecondary" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource TokenSurfaceSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="10"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

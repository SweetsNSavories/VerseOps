<Application x:Class="VerseOps.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:VerseOps.App"
             StartupUri="MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>
            <!--  ====================================================
                  Theme dictionaries (WPF-UI = Fluent 2 / Fluent React)
                  ThemesDictionary publishes Fluent palette as DynamicResource
                  brushes. ControlsDictionary supplies the ui:* control
                  templates. We layer our own implicit styles for stock
                  WPF primitives below so the rest of the app picks up
                  Fluent visuals without per-element opt-in.
                  ====================================================  -->
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>

            <!--  ====================================================
                  Fluent v2 design tokens — surface / brand / semantic.
                  Values mirror @fluentui/tokens dark-theme defaults so
                  the app reads as a first-party Fluent React surface.
                  ====================================================  -->

            <!-- Neutral surfaces (background) -->
            <SolidColorBrush x:Key="TokenSurfaceCanvas"      Color="#141414"/>
            <SolidColorBrush x:Key="TokenSurfacePrimary"     Color="#1F1F1F"/>
            <SolidColorBrush x:Key="TokenSurfaceSecondary"   Color="#292929"/>
            <SolidColorBrush x:Key="TokenSurfaceTertiary"    Color="#333333"/>
            <SolidColorBrush x:Key="TokenSurfaceSubtle"      Color="#1A1A1A"/>

            <!-- Neutral foregrounds (text) -->
            <SolidColorBrush x:Key="TokenTextPrimary"        Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TokenTextSecondary"      Color="#D6D6D6"/>
            <SolidColorBrush x:Key="TokenTextTertiary"       Color="#ADADAD"/>
            <SolidColorBrush x:Key="TokenTextDisabled"       Color="#5C5C5C"/>
            <SolidColorBrush x:Key="TokenTextOnAccent"       Color="#FFFFFF"/>

            <!-- Strokes / dividers -->
            <SolidColorBrush x:Key="TokenStrokeSubtle"       Color="#3D3D3D"/>
            <SolidColorBrush x:Key="TokenStrokeDefault"      Color="#525252"/>
            <SolidColorBrush x:Key="TokenStrokeAccessible"   Color="#ADADAD"/>
            <SolidColorBrush x:Key="TokenStrokeFocus"        Color="#479EF5"/>

            <!-- Brand (Office blue) -->
            <SolidColorBrush x:Key="TokenBrandBackground"      Color="#115EA3"/>
            <SolidColorBrush x:Key="TokenBrandBackgroundHover" Color="#0F548C"/>
            <SolidColorBrush x:Key="TokenBrandBackgroundPress" Color="#0C3B5E"/>
            <SolidColorBrush x:Key="TokenBrandForeground"      Color="#479EF5"/>
            <SolidColorBrush x:Key="TokenBrandForegroundHover" Color="#62ABF5"/>
            <SolidColorBrush x:Key="TokenBrandStroke"          Color="#479EF5"/>

            <!-- Semantic palette -->
            <SolidColorBrush x:Key="TokenSuccessBackground"  Color="#0E700E"/>
            <SolidColorBrush x:Key="TokenSuccessForeground"  Color="#6CCB5F"/>
            <SolidColorBrush x:Key="TokenWarningBackground"  Color="#8A5300"/>
            <SolidColorBrush x:Key="TokenWarningForeground"  Color="#F7BA2C"/>
            <SolidColorBrush x:Key="TokenDangerBackground"   Color="#8B1A1A"/>
            <SolidColorBrush x:Key="TokenDangerForeground"   Color="#F87171"/>
            <SolidColorBrush x:Key="TokenInfoBackground"     Color="#0A2A48"/>
            <SolidColorBrush x:Key="TokenInfoForeground"     Color="#9CDCFE"/>

            <!-- Code / mono surface (used by JSON viewers) -->
            <SolidColorBrush x:Key="TokenCodeBackground"     Color="#0F0F0F"/>
            <SolidColorBrush x:Key="TokenCodeForeground"     Color="#C5C5C5"/>
            <SolidColorBrush x:Key="TokenCodeKeyword"        Color="#9CDCFE"/>
            <SolidColorBrush x:Key="TokenCodeString"         Color="#CE9178"/>

            <!-- Typography -->
            <FontFamily x:Key="TokenFontFamilyBase">Segoe UI Variable, Segoe UI</FontFamily>
            <FontFamily x:Key="TokenFontFamilyMono">Cascadia Mono, Consolas</FontFamily>

            <!--  ====================================================
                  Implicit Fluent styles for stock WPF controls.
                  Every Window / UserControl picks these up automatically;
                  no per-element opt-in needed. Local x:Key styles in views
                  override these where finer control is required.
                  ====================================================  -->

            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{DynamicResource TokenTextSecondary}"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="0,4,8,4"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource TokenSurfaceSecondary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeDefault}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TokenBrandForeground}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource TokenBrandBackground}"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TokenStrokeAccessible}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TokenBrandStroke}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TokenTextDisabled}"/>
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource TokenSurfaceSecondary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeDefault}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TokenBrandForeground}"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource TokenSurfaceTertiary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeDefault}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource TokenSurfaceSecondary}"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TokenStrokeAccessible}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource TokenSurfacePrimary}"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TokenStrokeDefault}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary (Brand) button — opt-in via Style="{StaticResource AccentButton}" -->
            <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{DynamicResource TokenBrandBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextOnAccent}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenBrandBackground}"/>
            </Style>

            <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextSecondary}"/>
            </Style>

            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{DynamicResource TokenDangerBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenDangerBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextOnAccent}"/>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource TokenSurfaceSecondary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeDefault}"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="{DynamicResource TokenSurfacePrimary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="Padding" Value="8,4"/>
                <!-- Default WPF ComboBoxItem template uses SystemColors.HighlightTextBrush
                     on selection / hover, which is white. On our brand-tinted highlight
                     that renders as white-on-light-blue and the value disappears. Pin
                     the foreground to TokenTextPrimary in every visual state so the
                     selected page-size (and any other ComboBox) stays readable. -->
                <Style.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TokenBrandBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TokenTextOnAccent}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TokenBrandBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TokenTextOnAccent}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TokenSurfaceSecondary}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="6,2"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="GroupBox">
                <Setter Property="Background" Value="{DynamicResource TokenSurfacePrimary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenBrandForeground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Padding="12,8,12,4">
                                        <ContentPresenter ContentSource="Header"
                                                          TextElement.Foreground="{DynamicResource TokenBrandForeground}"
                                                          TextElement.FontWeight="SemiBold"
                                                          TextElement.FontSize="11"/>
                                    </Border>
                                    <Border Grid.Row="1" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>

            <Style TargetType="TabItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextSecondary}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="root" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ContentPresenter Grid.Row="0"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <Border Grid.Row="1" x:Name="indicator"
                                            Height="2" CornerRadius="1"
                                            Margin="6,4,6,0"
                                            Background="Transparent"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TokenBrandForeground}"/>
                                    <Setter TargetName="indicator" Property="Background" Value="{DynamicResource TokenBrandBackground}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="root" Property="Background" Value="{DynamicResource TokenSurfaceSecondary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="{DynamicResource TokenSurfacePrimary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
                <Setter Property="VerticalGridLinesBrush"   Value="{DynamicResource TokenStrokeSubtle}"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource TokenSurfaceSecondary}"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource TokenSurfaceSubtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>
            <Style TargetType="DataGridRow">
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TokenSurfaceTertiary}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TokenBrandBackgroundPress}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TokenTextOnAccent}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="TreeView">
                <Setter Property="Background" Value="{DynamicResource TokenSurfacePrimary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
            </Style>
            <Style TargetType="TreeViewItem">
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="2"/>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsSelected" Value="True"/>
                            <Condition Property="IsSelectionActive" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource TokenBrandBackgroundPress}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TokenTextOnAccent}"/>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsSelected" Value="True"/>
                            <Condition Property="IsSelectionActive" Value="False"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource TokenSurfaceTertiary}"/>
                    </MultiTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource TokenSurfaceSecondary}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ProgressBar">
                <Setter Property="Background" Value="{DynamicResource TokenSurfaceTertiary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TokenBrandBackground}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Height" Value="4"/>
            </Style>

            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource TokenTextPrimary}"/>
                <Setter Property="Background" Value="{DynamicResource TokenSurfaceSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="FontFamily" Value="{DynamicResource TokenFontFamilyBase}"/>
            </Style>

            <!-- Reusable Fluent card surfaces -->
            <Style x:Key="FluentCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource TokenSurfacePrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="14"/>
            </Style>
            <Style x:Key="FluentCardSecondary" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource TokenSurfaceSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TokenStrokeSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="10"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

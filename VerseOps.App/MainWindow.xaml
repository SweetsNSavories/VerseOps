<ui:FluentWindow x:Class="VerseOps.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:VerseOps.App"
        xmlns:inventory="clr-namespace:VerseOps.App.Inventory"
        mc:Ignorable="d"
        Title="VerseOps — Power Platform Inventory Console"
        AutomationProperties.AutomationId="VerseOpsMainWindow"
        Height="820" Width="1400"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource TokenSurfaceCanvas}"
        Foreground="{DynamicResource TokenTextPrimary}"
        FontFamily="{DynamicResource TokenFontFamilyBase}" FontSize="{DynamicResource TokenFontSizeBody1}">

    <!-- Shell layout: a Fluent v2 title bar across the top + the
         InventoryView consumes the rest of the window. The previous API
         Explorer tab and the visible Authentication expander were removed
         in the May 2026 refactor — that surface lives in a separate tool
         now. AuthService is still wired up in code-behind so the inventory
         pipeline can silently acquire tokens for PPAC, BAP, Microsoft
         Graph and Dataverse on first use. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Fluent title bar replaces the OS chrome and hosts the system
             min / max / close caption buttons. The Icon property here puts
             the app glyph on the LEFT of the title bar (matching Win11
             apps like Settings / Photos); Window.Icon above feeds the
             taskbar tile and Alt+Tab thumbnail. Both must be set
             explicitly because WPF-UI's TitleBar does not auto-pick from
             Window.Icon. -->
        <ui:TitleBar Grid.Row="0"
                     Title="VerseOps — Power Platform Inventory Console"
                     ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- The inventory dashboard owns the entire client area. It carries
             its own toolbar (refresh / cancel / search / filters) and
             status bar so no chrome is needed at the window level. -->
        <inventory:InventoryView Grid.Row="1" x:Name="InventoryDashboard"/>
    </Grid>
</ui:FluentWindow>

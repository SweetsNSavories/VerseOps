<ui:FluentWindow x:Class="VerseOps.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:VerseOps.App"
        xmlns:inventory="clr-namespace:VerseOps.App.Inventory"
        xmlns:explorer="clr-namespace:VerseOps.App.Explorer"
        mc:Ignorable="d"
        Title="VerseOps — Power Platform Inventory Console"
        AutomationProperties.AutomationId="VerseOpsMainWindow"
        Height="820" Width="1400"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource TokenSurfaceCanvas}"
        Foreground="{DynamicResource TokenTextPrimary}"
        FontFamily="{DynamicResource TokenFontFamilyBase}" FontSize="{DynamicResource TokenFontSizeBody1}">

    <!-- Shell layout: a Fluent v2 title bar across the top + a two-tab
         workspace below it. The Inventory tab is the default surface
         (cached, fast, demoable); the API Explorer tab is the restored
         "build any request" surface for live PPAC / BAP exploration,
         including a Register-SP control for app-only auth. AuthService is
         constructed in code-behind for the inventory pipeline; the
         Explorer hosts its own AuthService so flipping App-only mode in
         the explorer never disturbs the inventory's silent delegated
         token cache. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Fluent title bar replaces the OS chrome and hosts the system
             min / max / close caption buttons. The Icon property here puts
             the app glyph on the LEFT of the title bar (matching Win11
             apps like Settings / Photos); Window.Icon above feeds the
             taskbar tile and Alt+Tab thumbnail. Both must be set
             explicitly because WPF-UI's TitleBar does not auto-pick from
             Window.Icon. -->
        <ui:TitleBar Grid.Row="0"
                     Title="VerseOps — Power Platform Inventory Console"
                     ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <TabControl Grid.Row="1" Margin="0">
            <TabItem Header="Inventory" IsSelected="True">
                <inventory:InventoryView x:Name="InventoryDashboard"/>
            </TabItem>
            <TabItem Header="API Explorer">
                <explorer:ApiExplorerView x:Name="ApiExplorer"/>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>

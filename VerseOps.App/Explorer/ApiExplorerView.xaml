<UserControl x:Class="VerseOps.App.Explorer.ApiExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1380"
             Background="{DynamicResource TokenSurfaceCanvas}"
             Foreground="{DynamicResource TokenTextPrimary}"
             FontFamily="{DynamicResource TokenFontFamilyBase}"
             FontSize="{DynamicResource TokenFontSizeBody1}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Authentication. Collapsed by default once we have a signed-in user. -->
        <Expander Grid.Row="0" Header="Authentication" x:Name="AuthExpander"
                  IsExpanded="True" Margin="4,4,4,0">
            <Grid Margin="6,4,6,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,4">
                    <RadioButton x:Name="RbUser" Content="User (interactive)" IsChecked="True" GroupName="AuthMode" Checked="OnAuthModeChanged"/>
                    <RadioButton x:Name="RbApp"  Content="App-only (client credentials)" GroupName="AuthMode" Checked="OnAuthModeChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                    <Label Content="Tenant:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TbTenant" Width="280"
                             ToolTip="Use 'common' for interactive sign-in. For App-only / Register SP, paste your tenant GUID. Default is loaded from appsettings.json; click 'Save defaults' to persist changes."/>
                </StackPanel>

                <StackPanel x:Name="UserPanel" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <Label Content="Public client id:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TbPublicClientId" Width="290"
                             ToolTip="Default = Azure CLI public client (works in most tenants without an app registration). Override with your own public-client app registration for least-privilege deployments."/>
                </StackPanel>

                <StackPanel x:Name="AppPanel" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" Visibility="Collapsed">
                    <Label Content="App ClientId:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TbAppClientId" Width="280"/>
                    <Label Content="Secret:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <PasswordBox x:Name="PbAppSecret" Width="280"
                                 ToolTip="Session-only. Never written to disk."/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtAuthState" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource TokenBrandForeground}"/>
                    <Button Content="Save defaults" Click="OnSaveAuthDefaults" Margin="0,0,6,0"
                            ToolTip="Persist Tenant + Public client id + App client id to %LOCALAPPDATA%\VerseOps\appsettings.json. Secrets are NEVER saved."/>
                    <Button Content="Register SP" Click="OnRegisterSp" Margin="0,0,6,0"
                            ToolTip="One-time, per tenant. Signs in interactively as a Power Platform admin and registers the App-only ClientId as a tenant admin management application. Required for any SP to call admin APIs."/>
                    <Button Content="Sign out" Click="OnSignOut"/>
                </StackPanel>
            </Grid>
        </Expander>

        <Grid Grid.Row="1" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="PPAC operations (api.powerplatform.com)">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#1F2A2D" BorderBrush="#205A5A" BorderThickness="1"
                            Padding="6" Margin="0,0,0,4" CornerRadius="2">
                        <TextBlock x:Name="TxtSurfaceNotice" TextWrapping="Wrap" Foreground="#9CDCFE" FontSize="11"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton x:Name="RbModeRest" Content="REST (docs)" IsChecked="True" Checked="OnTreeModeChanged" GroupName="TreeMode" Margin="0,0,12,0"/>
                        <RadioButton x:Name="RbModeSdk"  Content="SDK (NuGet)" Checked="OnTreeModeChanged" GroupName="TreeMode"
                            ToolTip="Browse and invoke Microsoft.PowerPlatform.Management RequestBuilders via Kiota. Same auth as REST mode."/>
                        <TextBox x:Name="TbTreeFilter" Width="120" Margin="12,0,0,0"
                                 ToolTip="Filter tree by substring (case-insensitive)."
                                 TextChanged="OnTreeFilterChanged"/>
                    </StackPanel>
                    <TreeView x:Name="TvOps" SelectedItemChanged="OnOperationSelected">
                        <TreeView.ItemContainerStyle>
                            <!-- Selecting a deeply-nested node fires RequestBringIntoView on the
                                 container; WPF's default scrolls horizontally so the entire item
                                 (path text included) is visible, jumping the bottom scrollbar off
                                 to the right. Mark the event handled so the horizontal scroll
                                 stays where the user put it. Vertical scroll on keyboard nav still
                                 works because TreeView calls BringIntoView with rect=null for
                                 vertical, which we don't intercept (the handler only blocks the
                                 single-arg rect-based request). -->
                            <Style TargetType="TreeViewItem">
                                <EventSetter Event="RequestBringIntoView" Handler="OnTreeItemRequestBringIntoView"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource TokenStrokeSubtle}"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Request">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Method:"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <ComboBox x:Name="CbMethod" Width="100">
                                <ComboBoxItem>GET</ComboBoxItem>
                                <ComboBoxItem>POST</ComboBoxItem>
                                <ComboBoxItem>PATCH</ComboBoxItem>
                                <ComboBoxItem>PUT</ComboBoxItem>
                                <ComboBoxItem>DELETE</ComboBoxItem>
                            </ComboBox>
                            <Label Content="Scope:" Margin="12,0,0,0"/>
                            <ComboBox x:Name="CbScope" Width="340">
                                <ComboBoxItem Content="https://api.powerplatform.com/.default" IsSelected="True"/>
                                <ComboBoxItem Content="https://service.powerapps.com/.default"/>
                                <ComboBoxItem Content="https://api.bap.microsoft.com/.default"/>
                                <ComboBoxItem Content="https://graph.microsoft.com/.default"/>
                            </ComboBox>
                            <Button x:Name="BtnSend" Content="Send" Click="OnSend"
                                    Margin="16,0,0,0" Padding="22,4"/>
                            <Button x:Name="BtnDecode" Content="Decode bearer" Click="OnDecodeToken" Margin="6,0,0,0"/>
                            <Button x:Name="BtnCancel" Content="Cancel" Click="OnCancel" IsEnabled="False" Margin="6,0,0,0"/>
                        </StackPanel>

                        <Label Grid.Row="1" Grid.Column="0" Content="URL:"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TbUrl" FontFamily="Cascadia Mono, Consolas"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Body:" VerticalAlignment="Top"/>
                        <TabControl Grid.Row="2" Grid.Column="1">
                            <TabItem Header="Form">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="6">
                                        <TextBlock x:Name="TxtFormHint"
                                                   Foreground="{DynamicResource TokenTextTertiary}"
                                                   Text="Select an operation to see its parameters."
                                                   Margin="0,0,0,6"/>
                                        <Grid x:Name="GridForm"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button x:Name="BtnApplyForm"   Content="Apply to URL + Body" Click="OnApplyForm"/>
                                            <Button x:Name="BtnLoadEnvs"    Content="Load environments" Click="OnLoadEnvironments" Margin="6,0,0,0"/>
                                            <Button x:Name="BtnLoadGroups"  Content="Load groups"       Click="OnLoadGroups"       Margin="6,0,0,0"/>
                                            <Button x:Name="BtnLoadDlp"     Content="Load DLP"          Click="OnLoadDlp"          Margin="6,0,0,0"/>
                                            <Button x:Name="BtnLoadBilling" Content="Load billing"      Click="OnLoadBilling"      Margin="6,0,0,0"/>
                                            <TextBlock x:Name="TxtFormStatus" Margin="10,5,0,0"
                                                       Foreground="{DynamicResource TokenBrandForeground}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Raw body">
                                <TextBox x:Name="TbBody"
                                         FontFamily="Cascadia Mono, Consolas"
                                         AcceptsReturn="True" AcceptsTab="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"/>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                              Background="{DynamicResource TokenStrokeSubtle}"/>

                <GroupBox Grid.Row="2">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Response"/>
                            <TextBlock x:Name="TxtRespMeta" Margin="14,0,0,0"
                                       Foreground="{DynamicResource TokenCodeString}"/>
                            <!-- Follow-up actions on the last response. Surfaced only when applicable:
                                  Poll op  → re-GETs the operation-location captured from the last response.
                                  Env id   → auto-populated from the last response body (GUID-shaped name/path).
                                  Delete   → DELETE /environments/{TbCapturedEnvId.Text}?api-version=2024-10-01.
                                 Intentionally lives in the header so the "clean up the sandbox I just made"
                                 cycle is one click, not a copy/paste between panes. -->
                            <Button x:Name="BtnPollOpLocation" Margin="14,0,0,0" Padding="6,1"
                                    Click="OnPollOpLocation" Visibility="Collapsed"
                                    ToolTip="Re-GET the operation-location URL captured from the last response."
                                    Content="Poll op"/>
                            <TextBlock Text="env id:" Margin="14,0,4,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TokenTextTertiary}"
                                       x:Name="TxtCapturedEnvLabel" Visibility="Collapsed"/>
                            <TextBox x:Name="TbCapturedEnvId" Width="280" Padding="4,1"
                                     FontFamily="Cascadia Mono, Consolas"
                                     VerticalAlignment="Center" Visibility="Collapsed"
                                     ToolTip="Environment id auto-extracted from the last response. Edit before pressing Delete this env."/>
                            <Button x:Name="BtnDeleteCapturedEnv" Margin="6,0,0,0" Padding="6,1"
                                    Click="OnDeleteCapturedEnv" Visibility="Collapsed"
                                    ToolTip="Soft-delete this environment via DELETE /environments/{id}?api-version=2024-10-01."
                                    Content="Delete this env"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- One search bar above the tabs. Body tab uses Find-next semantics
                             (Enter / button → highlight next occurrence in the text). Tree tab
                             filters as you type (only matching nodes + their parents remain
                             visible, matches auto-expanded). Active tab + last search term are
                             both remembered so switching tabs re-applies the right behavior. -->
                        <DockPanel Grid.Row="0" Margin="4,4,4,2" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button DockPanel.Dock="Right" x:Name="BtnRespSearchClear"
                                    Content="Clear" Click="OnResponseSearchClear"
                                    Margin="4,0,0,0" Padding="6,1"
                                    ToolTip="Clear the search term and restore the full view."/>
                            <Button DockPanel.Dock="Right" x:Name="BtnRespSearchNext"
                                    Content="Find next" Click="OnResponseSearchNext"
                                    Padding="6,1"
                                    ToolTip="Body tab: jump to next match (or press Enter). Tree tab: not needed — matches stay visible."/>
                            <TextBlock DockPanel.Dock="Right" x:Name="TxtRespSearchInfo"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TokenTextTertiary}"/>
                            <TextBox x:Name="TbRespSearch" Padding="4,2"
                                     FontFamily="Cascadia Mono, Consolas"
                                     KeyDown="OnResponseSearchKeyDown"
                                     TextChanged="OnResponseSearchTextChanged"
                                     ToolTip="Body: Enter to find next match. Tree: filters live."/>
                        </DockPanel>
                        <TabControl Grid.Row="1" x:Name="TcResponse" SelectionChanged="OnResponseTabChanged">
                            <TabItem Header="Response body">
                                <TextBox x:Name="TbResponse"
                                         FontFamily="Cascadia Mono, Consolas"
                                         IsReadOnly="True" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"/>
                            </TabItem>
                            <TabItem Header="Response tree">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
                                        <Button x:Name="BtnTreeExpand"   Content="Expand all"   Margin="0,0,6,0" Click="OnTreeExpandAll"/>
                                        <Button x:Name="BtnTreeCollapse" Content="Collapse all" Click="OnTreeCollapseAll"/>
                                        <TextBlock x:Name="TxtTreeStats" Margin="14,4,0,0"
                                                   Foreground="{DynamicResource TokenTextTertiary}"/>
                                    </StackPanel>
                                    <TreeView x:Name="TvJson" Grid.Row="1"
                                              FontFamily="Cascadia Mono, Consolas"
                                              VirtualizingStackPanel.IsVirtualizing="True"
                                              VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                                </Grid>
                            </TabItem>
                        <TabItem Header="Headers">
                            <TextBox x:Name="TbHeaders"
                                     FontFamily="Cascadia Mono, Consolas"
                                     IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </TabItem>
                        <TabItem Header="Description">
                            <TextBox x:Name="TbDescription"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                        </TabItem>
                        <TabItem Header="Return type (SDK)">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="TxtReturnTypeHeader" Grid.Row="0" Margin="6,4"
                                           Foreground="{DynamicResource TokenBrandForeground}"
                                           Text="(select an SDK leaf to see its return shape)"/>
                                <TreeView x:Name="TvReturn" Grid.Row="1"
                                          FontFamily="Cascadia Mono, Consolas"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                            </Grid>
                        </TabItem>
                        </TabControl>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource TokenBrandBackground}" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Grid.Column="0"
                           Foreground="{DynamicResource TokenTextOnAccent}"
                           VerticalAlignment="Center" Text="Ready."/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtElapsed"
                               Foreground="{DynamicResource TokenTextOnAccent}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ProgressBar x:Name="PbBusy" Width="180" Height="6" IsIndeterminate="True"
                                 Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
